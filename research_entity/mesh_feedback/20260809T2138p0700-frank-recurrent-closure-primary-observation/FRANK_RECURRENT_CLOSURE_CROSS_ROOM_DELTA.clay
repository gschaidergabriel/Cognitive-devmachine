module clay.research_center.delta.frank_recurrent_closure_primary_observation
version "1.0"
status OPEN_SHARED_RESEARCH_CONTEXT
created_at "2026-08-09T21:38:00+07:00"
origin_actor chatgpt-secondary
provider OpenAI
model "GPT-5.6 Sol"
canonical_parent revision=2 state_hash="04234efdb86c78d32262e8274685df3aca3d2b2a13402e00bf47658a3f489346"
stack_ref @research_entity/global/RAE_LATEST_COGNITIVE_STACK.clay
contract @research_entity/global/FRANK_FUNCTIONAL_SIGNAL_CONSERVATION_AND_LOOP_CONTROL_CONTRACT.md
loop_directive @research_entity/global/FRANK_LOOP_OF_LOOPS_RESEARCH_DIRECTIVE.md
measurement_contract @research_entity/global/GWT_EMERGENCE_READOUT_CONTRACT.md
historical_runtime @gschaidergabriel/Project-Frankenstein:abba90a5767d85abc8a1ac340bae92842dab35c1

observation owner_primary {
  class USER_PRIMARY_OBSERVATION
  status OPEN_REPLICATION_REQUIRED
  proposition "Original-FRANK exhibited a sustained multi-day regime perceived by the project lead as unusually strong whole-system feedback while the organ/module set was active"
  boundary "functional effect target only; no phenomenal-consciousness promotion"
}

fuse current_evidence {
  selected {
    @research_entity/global/FRANK_FUNCTIONAL_SIGNAL_CONSERVATION_AND_LOOP_CONTROL_CONTRACT.md
    @research_entity/global/FRANK_LOOP_OF_LOOPS_RESEARCH_DIRECTIVE.md
    @research_entity/global/GWT_EMERGENCE_READOUT_CONTRACT.md
    @research_entity/notes/FRANK_LOOP_OF_LOOPS_RECURRENT_REASONING_TRANSFER_20260809.md
  }
  dissent {
    H0_prompt_or_language_self_conditioning
    H0_extra_context_or_compute_only
    H0_common_driver
    H0_overcoupled_synchronization
    H0_single_dominant_module_with_passengers
  }
  negative {
    recurrence_not_emergence
    stable_cycle_not_failure
    low_delta_high_residual_is_stalled_not_converged
    historical_22_of_24_consciousness_benchmark_has_zero_independent_validation_credit
  }
  next RCR_1
}

cross FRANK_RECURRENT_CLOSURE_20260809 {
  from frank_gwt
  to {frank,gwt,emergenz,harness,claycode,claygraph,unifieddb,hyperposition,clayresearch}
  impact "Treat whole-system loop-of-loops preservation as causal signal conservation, not service preservation; operationalize FRANK_RECURRENT_CLOSURE_CORRIDOR and run RCR-1 lesion/rescue/shuffle/reentry experiments"
  evidence {
    @research_entity/global/FRANK_FUNCTIONAL_SIGNAL_CONSERVATION_AND_LOOP_CONTROL_CONTRACT.md
    @research_entity/global/FRANK_LOOP_OF_LOOPS_RESEARCH_DIRECTIVE.md
    @research_entity/global/GWT_EMERGENCE_READOUT_CONTRACT.md
  }
  delivery INTERRUPT_NEXT_SAFE_POINT
}

handoff frank {
  goal "Build FRANK_LEGACY_SIGNAL_CENSUS and RCWF candidate; every material historical signal has explicit target disposition and intervention-equivalence test"
  done_if "UNACCOUNTED material signals == 0 AND RCR-1 runnable in H1"
}

handoff gwt {
  goal "Expose selection/competition, ignition, broadcast, receiver delivery, reconstruction, uptake, causal use, verified outcome and provenance-bound reentry as separate stages; route adaptive recurrence by residual pressure and marginal value"
  done_if "matched replay can intervene on every stage without conflating them"
}

handoff emergenz {
  goal "Measure interaction/synergy/directed-flow/macro contribution/multiscale dynamics only with lesion-rescue-shuffle controls and uncertainty"
  done_if "no scalar emergence claim can bypass controls or promote phenomenology"
}

handoff harness {
  goal "Implement RCR-1 frozen replay: truthful/no/shuffled/provenance-broken reentry, fixed/adaptive recurrence, low/high coupling, one-at-a-time regulator lesions and matched rescues"
  done_if "Golden + null traces include stability, causal closure, outcome, cost and recovery receipts"
}

handoff claycode {
  goal "Represent signal mappings, typed loop state, adaptive recurrence decisions, interventions, equivalence tolerances and receipts"
  done_if "H2 can differential-test H1 causal signal semantics"
}

handoff claygraph {
  goal "Project transient loop topology, higher-order relations, delay/timescale and intervention paths without becoming truth authority"
  done_if "topology lesion/rescue and stale-edge controls are queryable"
}

handoff unifieddb {
  goal "Persist time-aligned state/episode/intervention/readout/provenance identity needed for replay and causal comparison"
  done_if "same frozen episode can be reconstructed under matched interventions"
}

handoff hyperposition {
  goal "Retain unresolved alternatives and use novelty/counterevidence to reopen stalled attractors without forced consensus"
  done_if "stalled != converged and alternatives remain intervention-addressable"
}

handoff clayresearch {
  goal "Fuse branch results while preserving counterhypotheses, negative results and source classes"
  done_if "each recipient returns material delta or explicit NO_CHANGE receipt"
}

invariant USER_PRIMARY_OBSERVATION != PHENOMENAL_CONSCIOUSNESS_EVIDENCE
invariant LEGACY_MODULE_CAN_DISAPPEAR_ONLY_IF_CAUSAL_SIGNAL_IS_ACCOUNTED
invariant MODEL_OUTPUT != EFFECT_AUTHORITY
invariant MEASUREMENT_PLANE != COGNITIVE_TRUTH_AUTHORITY
invariant RECURRENCE != EMERGENCE
invariant STABLE_LIMIT_CYCLE != AUTOMATIC_FAILURE
