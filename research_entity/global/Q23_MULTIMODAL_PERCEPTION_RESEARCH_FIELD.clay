record Q23HypothesisNode {
  hypothesis_id:Ref
  run_id:Ref
  parent_hypotheses:Set<Ref>
  parent_packages:Set<Ref>
  derived_from:FRONTIER_GAP|CONTRADICTION|EXTERNAL_FINDING|RUNTIME_AFFORDANCE|NEGATIVE_RESULT|CROSS_DOMAIN_TRANSFER|PACKAGE_INTERACTION|DEPENDENCY_CHANGE|GO_GLOBAL_DELTA|EXPERIENCE_DOSE_RESULT
  claim:Clay
  target_architecture_effect:Clay
  strongest_counterhypothesis:Clay
  falsifier:Clay
  cheapest_discriminating_test:Clay
  expected_signature_if_true:Clay
  expected_signature_if_false:Clay
  affected_components:Set<Ref>
  affected_work:Set<Ref>
  confidence:Score
  uncertainty:Score
  status:OPEN|TESTING|SUPPORTED|REFINED|REFUTED|SUPERSEDED
  provenance_refs:Set<Ref>
}

record Q23ResearchPackage {
  package_id:Ref
  run_id:Ref
  observed_at:Time
  topic:Ref
  title:Clay
  parent_source_edges:Set<Ref>
  source_class:OFFICIAL_MODEL|OFFICIAL_RUNTIME|PRIMARY_PAPER|PEER_REVIEWED|PRIMARY_DATASET|PRIMARY_GITHUB_PROJECT|COMPETING_PROJECT|ISSUE_OR_FAILURE|CURRENT_REPO|RUNTIME_RECEIPT|COUNTEREVIDENCE|INDEPENDENT_TECHNICAL|DISCOVERY_POINTER|GO_GLOBAL_DELTA|OTHER_VERIFIED
  source_refs:Set<Ref>
  source_dates:Set<Time>
  source_ancestry:Set<Ref>
  retrieval_queries:Set<Clay>
  currentness_note:Clay
  finding:Clay
  why_interesting_for_target_architecture:Clay
  internal_evidence_refs:Set<Ref>
  fusion_result:SUPPORTS|REFINES|CONTRADICTS|SUPERSEDES|ALTERNATIVE|NO_CHANGE
  hypothesis_created_or_revised:Set<Ref>
  counterhypothesis_created_or_revised:Set<Ref>
  architecture_delta_candidates:Set<Ref>
  test_obligations:Set<Ref>
  affected_components:Set<Ref>
  affected_work:Set<Ref>
  swarm_targets:Set<Ref>
  go_exchange_targets:Set<Ref>
  evidence_class:Ref
  confidence:Score
  unresolved_uncertainty:Clay
  falsifier:Clay?
  content_hash:Hash
  provenance_hash:Hash
}

record Q23SourceEdge {
  edge_id:Ref
  from_ref:Ref
  to_ref:Ref
  relation:CITES|IMPLEMENTS|CONFIGURES|EXTENDS|CONTRADICTS|BENCHMARKS|SUPERSEDES|FAILURE_MODE_OF|ALTERNATIVE_TO|DEPENDS_ON|DISCOVERS|REPLICATES|USES_DATASET
  expected_information_value:Score
  traversed:Bool
  result_package:Ref?
}

record Q23ResearchProgressDelta {
  delta_id:Ref
  run_id:Ref
  cycle_id:Ref
  kind:NEW_HYPOTHESIS|REVISED_HYPOTHESIS|NEW_COUNTERHYPOTHESIS|CONTRADICTION_EXPOSED|CONTRADICTION_RESOLVED|PRIMARY_EVIDENCE|IMPLEMENTATION_FACT|ARCHITECTURE_DELTA|TEST_DELTA|WORK_DELTA|NEGATIVE_RESULT|SOURCE_NETWORK_EXPANSION|UNCERTAINTY_REDUCTION|ALTERNATIVE_ELIMINATED|GO_Q23_QUESTION_CLOSED|EXPERIENCE_DOSE_DELTA
  before_frontier_hash:Hash
  after_frontier_hash:Hash
  evidence_refs:Set<Ref>
  affected_hypotheses:Set<Ref>
  affected_components:Set<Ref>
  information_gain:Score
  uncertainty_reduction:Score
  architecture_impact:Score
  description:Clay
}

record Q23ArchitectureDelta {
  delta_id:Ref
  parent_architecture_epoch:Ref
  package_refs:Set<Ref>
  target_components:Set<Ref>
  proposed_change:Clay
  preserved_historical_functions:Set<Ref>
  expected_benefit:Clay
  strongest_counterhypothesis:Clay
  discriminating_test:Clay
  matched_baselines:Set<Ref>
  metric_vector:Set<Ref>
  resource_budget:Clay
  rollback:Clay
  evidence_refs:Set<Ref>
  status:CANDIDATE|TESTING|SUPPORTED|REFUTED|PROMOTED|NO_CHANGE
}

record Q23ExperienceDoseStudy {
  study_id:Ref
  hypothesis_refs:Set<Ref>
  experience_unit_definition:Clay
  qwen_pretrained_knowledge_constant:Bool
  dose_ladder:Set<Int>
  experience_regimes:Set<Ref>
  system_variants:Set<Ref>
  sham_controls:Set<Ref>
  heldout_fixtures:Set<Ref>
  outcome_metrics:Set<Ref>
  N_onset:Int?
  N_robust:Int?
  N_90:Int?
  N_harm:Int?
  max_tested_N:Int
  onset_status:IDENTIFIED|GREATER_THAN_MAX_TESTED|INCONCLUSIVE|NO_EFFECT
  result_ref:Ref?
}

record Q23FrontierNode {
  frontier_id:Ref
  question:Clay
  parent_refs:Set<Ref>
  branch_class:DIRECT_TRUTH|IMPLEMENTATION|PRIMARY_RESEARCH|CITATION_EXPANSION|PROJECT_ECOLOGY|FAILURE_ECOLOGY|COUNTERMECHANISM|CROSS_DOMAIN|FRANK_GROUNDING|GO_GLOBAL_BRIDGE|EXPERIMENT|EXPERIENCE_DOSE|RECOVERY
  information_gain:Score
  mission_impact:Score
  falsification_value:Score
  novelty:Score
  dependency_unblock:Score
  cost:Score
  collision_risk:Score
  saturation:Score
  status:OPEN|ACTIVE|SATURATED|BLOCKED|CLOSED
}

