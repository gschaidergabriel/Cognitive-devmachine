{
  "schema": "FRANKENSTEIN_AI_INSTALL_CONTRACT/v1",
  "purpose": "scan-free capability-first host integration contract",
  "path_law": {
    "assume_downloads": false,
    "assume_home": false,
    "assume_clone_name": false,
    "assume_cwd": false,
    "repo_root_rule": "resolve from host file metadata or as parent of AI_START_HERE_DO_NOT_SCAN_REPO",
    "require_dynamic_or_host_metadata_resolution": true
  },
  "minimum_read_set": [
    "HUMAN_READ_THIS/README.md",
    "DEV_SOURCE_RESEARCH/README.md",
    "DEV_SOURCE_RESEARCH/repository/FRANKENSTEIN_SOURCE_INDEX.json",
    "research_entity/claycode/autonomous/SUPERVISOR_INBOX.json",
    "research_entity/claycode/autonomous/FREE_PROVIDER_ADMISSION.json"
  ],
  "capability_probe": [
    "read_project_files",
    "write_project_files",
    "execute_local_shell",
    "session_start_hook",
    "pre_task_hook",
    "post_task_hook",
    "durable_local_state",
    "tool_or_connector_calls",
    "effect_result_receipts",
    "pre_effect_gate"
  ],
  "host_routes": {
    "claude_code": "DETECT_THEN_MAP",
    "codex_cli": "DETECT_THEN_MAP",
    "hermes_agent": "DETECT_THEN_MAP",
    "chatgpt_web": "CONNECTED_SURFACES_ONLY",
    "claude_web": "CONNECTED_SURFACES_ONLY",
    "grok_web": "CONNECTED_SURFACES_ONLY",
    "generic": "MINIMUM_CONTEXT_AND_PROPOSED_DELTA_ONLY"
  },
  "required_proofs": [
    "PATH_RESOLUTION",
    "INSTRUCTION_LOAD",
    "CLAIMED_LIFECYCLE_HOOK_FIRES",
    "DURABLE_STATE_WRITE_READBACK_WHERE_SUPPORTED",
    "EFFECT_OR_TOOL_RESULT_RECEIPT_WHERE_SUPPORTED",
    "RESULT_REENTRY",
    "FAILURE_IS_DETECTABLE",
    "CURRENT_AUTHORITY_RESOLVED_BEFORE_EXTERNAL_EFFECT"
  ],
  "result_enum": [
    "NATIVE",
    "ADAPTED",
    "DEGRADED",
    "BLOCKED"
  ],
  "forbidden_claims": [
    "hard-coded path presented as dynamic",
    "unsupported lifecycle hook presented as installed",
    "conversation memory presented as canonical state",
    "model output presented as verified effect",
    "provider key presence presented as provider authority",
    "missing proof presented as success"
  ],
  "current_snapshot_note": {
    "date": "2026-08-27",
    "supervisor_schema": "9.13",
    "provider_state": "HARD_OFF_ALL_AUTONOMOUS_PROVIDER_ADMISSION_FALSE",
    "together": "FORBIDDEN",
    "paid_fallback": "FORBIDDEN",
    "frankenstein_supported_entrypoints": "SOURCE_LOCAL_UNIT_HARD_OFF_GATED_RUNTIME_EXECUTION_STILL_BLOCKED",
    "snapshot_is_not_future_authority": true
  }
}
