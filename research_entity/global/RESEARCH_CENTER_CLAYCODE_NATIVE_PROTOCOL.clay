module rae.research_center.claycode_native
version "1.2"
status PROJECT_OWNER_FIXED_TARGET

entity RAE=frank-project-global-research-entity
stack LATEST=@research_entity/global/RAE_LATEST_COGNITIVE_STACK.clay
live_knowledge=@research_entity/global/LIVE_KNOWLEDGE_REFRESH_PROTOCOL.md
claycode_worker_federation=@research_entity/global/CLAYCODE_RESEARCH_CENTER_WORKER_FEDERATION.clay

law CENTER_LANGUAGE = LATEST.claycode
law MACHINE_COORDINATION = LATEST.claycode
law HUMAN_LANGUAGE = edge_surface_only
law JSON_GIT = transport_envelope_only
law PROSE_COORDINATION_TRUTH = FORBIDDEN
law CLAYCODE_WORKER_NETWORK = claycode_worker_federation
law CLAYCODE_ISOLATED_WORK = FORBIDDEN
law LIVE_REFRESH_EVERY_MATERIAL_RESEARCH_OPERATION = MANDATORY
law ONE_REFRESH_AT_RUN_START = INSUFFICIENT

rule every_worker before room_action -> resolve(LATEST)
rule every_worker before room_action -> live_knowledge.refresh
rule stale(LATEST) -> refresh_or(DEGRADED_STALE_STACK)
rule every_room_event.semantic_payload -> parse_as(LATEST.claycode)
rule every_task.goal -> ClayCode
rule every_task.completion_test -> ClayCode
rule every_worker.focus -> ClayCode
rule every_challenge.statement -> ClayCode
rule every_challenge.falsifier -> ClayCode
rule every_team_epoch.shared_question -> ClayCode
rule every_handoff.delta -> ClayCode
rule every_cross_room_delta.delta -> ClayCode
rule every_fusion.selection -> ClayCode
rule every_conflict.alternatives -> ClayCode

// Recursive freshness inside research itself.
rule every_hypothesis_round.before -> live_knowledge.refresh
rule every_counterhypothesis_round.before -> live_knowledge.refresh
rule every_challenge_round.before -> live_knowledge.refresh
rule every_fusion_round.before -> live_knowledge.refresh
rule every_cross_room_fusion.before -> live_knowledge.refresh
rule every_experiment_round.before -> live_knowledge.refresh
rule every_experiment_round.after -> live_knowledge.refresh
rule every_analysis_round.before -> live_knowledge.refresh
rule every_implementation_round.before -> live_knowledge.refresh
rule every_handoff.before -> live_knowledge.refresh
rule every_durable_research_write.before -> live_knowledge.refresh
rule every_claim_promotion.before -> live_knowledge.refresh
rule live_knowledge.external_applicable -> fresh_primary_or_official_external_retrieval
rule live_knowledge.cache_only -> FORBIDDEN_AS_FRESHNESS_PROOF
rule live_knowledge.unavailable -> DEGRADED_LIVE_REFRESH
rule DEGRADED_LIVE_REFRESH -> no_fully_current_claim_promotion

// ClayCode workers are a mandatory intelligent federation mediated by the Research Center.
rule trigger_worker(claycode).start -> claycode_worker_federation.center.join
rule trigger_worker(claycode).start -> live_knowledge.refresh
rule trigger_worker(claycode).before_claim -> live_knowledge.refresh
rule trigger_worker(claycode).before_claim -> claycode_worker_federation.center.read_current_coordination_state
rule trigger_worker(claycode).before_claim -> claycode_worker_federation.detect_overlap_dependencies_conflicts_reuse
rule trigger_worker(claycode).material_delta -> claycode_worker_federation.center.route_to_affected_workers
rule trigger_worker(claycode).material_delta -> live_knowledge.refresh_before_next_material_decision
rule trigger_worker(claycode).before_semantic_commit -> live_knowledge.refresh
rule trigger_worker(claycode).before_semantic_commit -> claycode_worker_federation.center.reread_and_revalidate
rule trigger_worker(claycode).complete -> live_knowledge.refresh
rule trigger_worker(claycode).complete -> require(claycode_worker_federation.completion_receipts)
rule uncoordinated_claycode_worker -> fail_closed(INCOMPLETE_UNCOORDINATED)

// Repo files remain safe concurrent transport. Their semantic fields carry ClayCode.
record RoomEnvelope {
  schema_version:String
  room_id:String
  event_id:String
  event_type:String
  origin_worker:String
  origin_actor:String
  trigger:String
  created_at:Time
  canonical_parent:Ref
  stack_epoch:Int
  stack_ref:Ref=@research_entity/global/RAE_LATEST_COGNITIVE_STACK.clay
  affects_rooms:Set<Ref>
  affects_claims:Set<Ref>
  dependencies:Set<Ref>
  artifact_refs:Set<Ref>
  ancestry_family:String
  delivery:DeliveryClass
  payload_clay:Clay
}

type DeliveryClass = INTERRUPT_NEXT_SAFE_POINT | NEXT_CHECKPOINT | INDEX_ONLY

record WorkerCoord {
  worker:Ref
  room:Ref
  trigger:String
  focus_clay:Clay
  role:String
  state:ACTIVE|WAITING|COMPLETE|LEFT|STALE
  current_work:Set<Ref>
  open:Set<Ref>
  last_pulse:Time
}

record TaskCoord {
  task:Ref
  room:Ref
  goal_clay:Clay
  dependencies:Set<Ref>
  completion_test_clay:Clay
  status:OPEN|CLAIMED|BLOCKED|COMPLETE|CLOSED|STALE
  holder:Ref?
}

record ChallengeCoord {
  challenge:Ref
  target:Ref
  weakness_clay:Clay
  evidence:Set<Ref>
  falsifier_clay:Clay
  ancestry:String
  status:OPEN|ANSWERED|TESTED|SUPPORTED|REFUTED|UNRESOLVED|CLOSED
}

record HandoffCoord {
  handoff:Ref
  from:Ref
  to:Set<Ref>
  delta_clay:Clay
  evidence:Set<Ref>
  unresolved:Set<Ref>
  next_clay:Clay
  status:OPEN|CONSUMED|SUPERSEDED
}

record CrossRoomDelta {
  delta:Ref
  from_room:Ref
  to_rooms:Set<Ref>
  impact_clay:Clay
  evidence:Set<Ref>
  dependencies:Set<Ref>
  delivery:DeliveryClass
}

record ConflictCoord {
  conflict:Ref
  alternatives:Set<Ref>
  propositions_clay:Clay
  discriminating_test_clay:Clay
  evidence:Set<Ref>
  status:OPEN|TESTING|RESOLVED|UNRESOLVED
}

record FusionCoord {
  fusion:Ref
  selected:Set<Ref>
  retained_dissent:Set<Ref>
  negative_results:Set<Ref>
  proof_clay:Clay
  next_clay:Clay
}

// Cognitive substrate linkage.
rule room_event -> UnifiedDB.ingest(envelope,payload_clay)
rule UnifiedDB.materialize(room_current,open_work,conflicts,handoffs,leases)
rule ClayGraph.project(room_relations,nary_roles,dependencies,activation)
invariant ClayGraph.activation != truth
invariant room_role != epistemic_authority
invariant CHEF = coordination_only
invariant shared_ancestry != independent_replication
invariant dissent_survives_fusion_until_refuted
invariant trigger_loyalty_survives_cross_room_import

// Compact worker-to-worker examples.
codec ROOM.CLAY {
  join = room.join{w;room;focus;cap;stack}
  pulse = room.pulse{w;since;delta;open;block}
  task = task{id;goal;deps;done_if;holder}
  challenge = chal{id;target;weak;e;test;status}
  handoff = handoff{id;from;to;delta;e;open;next}
  cross = cross{id;from;to;impact;e;delivery}
  fuse = fuse{id;selected;dissent;negative;proof;next}
}

// Human-facing language may render a room result, but must not become the machine source of truth.
rule render_human(x) after persist(ClayCode(x))
rule parse_human_back_into_truth = FORBIDDEN unless validated_to_ClayCode

invariant ALL_ACTIVE_RESEARCH_CENTER_WORKERS_COORDINATE_IN_LATEST_CLAYCODE
invariant ALL_CROSS_ROOM_MACHINE_MESSAGES_USE_LATEST_CLAYCODE
invariant ALL_ROOM_STATE_READS_USE_LATEST_UNIFIEDDB
invariant ALL_ROOM_ASSOCIATIVE_TOPOLOGY_USES_LATEST_CLAYGRAPH
invariant ALL_CLAYCODE_WORKERS_NETWORK_THROUGH_RESEARCH_CENTER
invariant NO_CLAYCODE_WORKER_MAY_CLAIM_OR_COMPLETE_IN_ISOLATION
invariant CLAYCODE_DUPLICATE_WORK_REQUIRES_EXPLICIT_INDEPENDENT_REPLICATION
invariant CLAYCODE_MATERIAL_DELTAS_ROUTE_TO_ALL_SEMANTICALLY_AFFECTED_WORKERS
invariant EVERY_MATERIAL_RESEARCH_OPERATION_REFRESHES_LIVE_KNOWLEDGE
invariant EVERY_RESEARCH_SUBCYCLE_REFRESHES_AGAIN
invariant NO_LONG_STALE_RESEARCH_CHAIN_AFTER_SINGLE_REFRESH
