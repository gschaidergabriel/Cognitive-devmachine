                if s.else_body:
                    out.append(f"{pre}else:"); out += self.stmts(s.else_body,indent+1)
        return out
    def lower_function(self,fn:FunctionIR)->str:
        params=', '.join(fn.params)
        lines=[f"def {fn.name}(rt{', ' if params else ''}{params}):"]+self.stmts(fn.body,1)
        if len(lines)==1:lines.append('    pass')
        return '\n'.join(lines)+'\n'
    def lower_program(self,p:ProgramIR)->str:
        hdr=f"# generated by ClayCode BASE {VERSION}\n"
        return hdr+'\n'.join(self.lower_function(f) for f in p.functions)


class CLowerer:
    """Tiny translation-validation backend for the pure integer core."""
    def expr(self,e:Expr)->str:
        if e.kind=='literal' and isinstance(e.value,(int,bool)): return str(int(e.value))
        if e.kind=='binary' and e.value in {'+','-','*','/','%','==','!=','<','>','<=','>='}:
            return f"({self.expr(e.args[0])} {e.value} {self.expr(e.args[1])})"
        raise ValueError(f'unsupported C expression: {e.kind}:{e.value}')
    def lower_main(self,p:ProgramIR)->str:
        if len(p.functions)!=1 or p.functions[0].name!='main' or p.functions[0].params:
            raise ValueError('C BASE proof accepts one zero-arg main')
        body=p.functions[0].body
        if len(body)!=1 or body[0].kind!='return': raise ValueError('C BASE proof requires direct return')
        ex=self.expr(body[0].expr)
        return '#include <stdio.h>\nint main(void){ long long v=(long long)'+ex+'; printf("%lld\\n",v); return 0; }\n'

# ---------------------------------------------------------------------------
# Explicit host authority/runtime ABI.
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class CapabilityToken:
    token_id: str
    resource: str
    verbs: frozenset[str]
    scope: str = "*"
    valid_until: float = 4102444800.0

@dataclass
class HostBinding:
    fn: Callable[...,Any]
    resource: str
    verb: str

class AuthorityDenied(PermissionError): pass

class RuntimeABI:
    def __init__(self, grants:list[CapabilityToken]|None=None):
        self.grants=list(grants or [])
        self.bindings:dict[str,HostBinding]={}
        self.receipts:list[dict[str,Any]]=[]
    def register(self,name:str,fn:Callable[...,Any],resource='pure',verb='call'):
        self.bindings[name]=HostBinding(fn,resource,verb)
    def _authorized(self,b:HostBinding)->bool:
        if b.resource=='pure':return True
        now=time.time()
        return any(t.resource==b.resource and b.verb in t.verbs and t.valid_until>=now for t in self.grants)
    def call(self,name:str,*args,**kwargs):
        if name not in self.bindings: raise KeyError(f"unbound host call {name}")
        b=self.bindings[name]
        if not self._authorized(b):
            self.receipts.append({'call':name,'authorized':False})
            raise AuthorityDenied(f"missing authority for {b.resource}:{b.verb}")
        t0=time.perf_counter(); ok=False
        try:
            v=b.fn(*args,**kwargs); ok=True; return v
        finally:
            self.receipts.append({'call':name,'authorized':True,'ok':ok,'elapsed_ms':(time.perf_counter()-t0)*1000})
    @staticmethod
    def get(v:Any,k:str)->Any:
        return v[k] if isinstance(v,dict) else getattr(v,k)
    @staticmethod
    def coalesce(left:Callable[[],Any], right:Callable[[],Any]):
        try: v=left()
        except (NameError, UnboundLocalError): v=None
        return v if v is not None else right()
    @staticmethod
    def record(name:str,*args,**kwargs):
        d={'__type__':name}
        if args: d['__args__']=list(args)
        d.update(kwargs); return d

# ---------------------------------------------------------------------------
# Minimal Ubuntu/Linux-oriented SDK adapters used by the proof suite.
# ---------------------------------------------------------------------------

class SDK:
    def __init__(self, root:Path):
        self.root=Path(root).resolve(); self.root.mkdir(parents=True,exist_ok=True)
        self.db=self.root/'app.sqlite'
        self.ui_state={'count':0,'last_render':''}; self.ui_backend='headless-queue'
    def _safe(self,p:str)->Path:
        q=(self.root/p).resolve()
        if self.root not in q.parents and q!=self.root: raise AuthorityDenied('path escape')
        return q
    def file_write(self,p:str,text:str)->int:
        q=self._safe(p); q.parent.mkdir(parents=True,exist_ok=True); q.write_text(text); return len(text)
    def file_read(self,p:str)->str:return self._safe(p).read_text()
    def process_echo(self,text:str)->str:
        cp=subprocess.run(['/usr/bin/printf','%s',text],capture_output=True,text=True,check=True); return cp.stdout
    def http_roundtrip(self,path:str,body:str)->str:
        body_map={path:body}
        class H(BaseHTTPRequestHandler):
            def do_GET(self):
                data=body_map.get(self.path,'404').encode(); self.send_response(200 if self.path in body_map else 404); self.end_headers(); self.wfile.write(data)
            def log_message(self,*a): pass
        srv=ThreadingHTTPServer(('127.0.0.1',0),H); th=threading.Thread(target=srv.serve_forever,daemon=True); th.start()
        try:
            with urllib.request.urlopen(f'http://127.0.0.1:{srv.server_port}{path}',timeout=2) as r:return r.read().decode()
        finally:srv.shutdown();srv.server_close();th.join(timeout=2)
    def db_transaction(self,key:str,delta:int)->int:
        con=sqlite3.connect(self.db, isolation_level=None)
        try:
            con.execute('create table if not exists kv(k text primary key,v integer not null)')
            con.execute('insert or ignore into kv(k,v) values(?,0)',(key,))
            con.execute('begin immediate')
            con.execute('update kv set v=v+? where k=?',(delta,key))
            v=con.execute('select v from kv where k=?',(key,)).fetchone()[0]
            con.execute('commit'); return int(v)
        except Exception:
            
            try: con.execute('rollback')
            except sqlite3.OperationalError: pass
            raise
        finally:con.close()
    def concurrent_sum(self,n:int)->int:
        async def run():
            async def job(i): await asyncio.sleep(0); return i*i
            return sum(await asyncio.gather(*(job(i) for i in range(n))))
        return asyncio.run(run())
    def concurrent_cancel(self)->str:
        async def run():
            async def sleeper(): await asyncio.sleep(10)
            t=asyncio.create_task(sleeper()); await asyncio.sleep(0); t.cancel()
            try: await t
            except asyncio.CancelledError:return 'cancelled'
        return asyncio.run(run())
    def atomic_increment(self,workers:int,iters:int)->int:
        value={'n':0}; lock=threading.Lock()
        def worker():
            for _ in range(iters):
                with lock: value['n'] += 1
        ts=[threading.Thread(target=worker) for _ in range(workers)]
        [t.start() for t in ts]; [t.join() for t in ts]
