module clay.atomic.gwt_thinkspace
version "0.1-owner-fixed-2026-08-10"
status PROJECT_OWNER_FIXED_RESEARCH_SUBSTRATE

law trigger = atomic
law target = self.root
law human_surface = "Frank"
law invention_language = ClayCode
law gwt_role = THINKSPACE
law gwt_consistent_candidate -> THINKABLE
law THINKABLE != TRUE
law THINKABLE != SUPPORTED
law THINKABLE != AUTHORIZED
law novelty_pressure != epistemic_authority
law gwt_ignition != effect_authority
law candidate_promotion_requires = evidence + falsifier_survival + provenance + required_authority

class AtomicEvidence = OWNER_FIXED | CURRENT_REPO | PRIMARY_EXTERNAL | OFFICIAL_EXTERNAL | SOURCE_CODE | H1 | H2 | H3 | TARGET_VPS | PROXY | FIXTURE | SYNTHETIC
class AtomicNovelty = KNOWN_EQUIVALENT | KNOWN_NEAR_ANALOGUE | NOVEL_COMBINATION_CANDIDATE | MECHANISM_NOVELTY_NOT_FOUND_IN_SEARCHED_SCOPE | NOVELTY_UNRESOLVED
class AtomicStatus = GENERATED | COHERENT | TESTABLE | TESTED | REFUTED | NO_GAIN | PROMISING | SUPPORTED_PROXY | SUPPORTED_TARGET | ARCHIVED | RETEST | ROUTED_FOR_INTEGRATION

record ThinkspaceCoordinate {
  topology: ClayCode;
  temporal_order: ClayCode;
  persistence_lifetime: ClayCode;
  selection_rule: ClayCode;
  broadcast_granularity: ClayCode;
  reentry_structure: ClayCode;
  uncertainty_geometry: ClayCode;
  causal_credit_path: ClayCode;
  memory_addressing: ClayCode;
  resource_allocation: ClayCode;
  module_boundary: ClayCode;
  self_reference_locality: ClayCode;
  failure_containment: ClayCode;
}

record AtomicHypothesis {
  id: Qid;
  problem_target: Qid;
  mechanism: ClayCode;
  expected_gain: MeasureSet;
  strongest_countermechanism: ClayCode;
  counterprediction: MeasureSet;
  falsifier: ExperimentSpec;
  minimum_test: ExperimentSpec;
  required_primitives: Set<Qid>;
  affected_modules: Set<Qid>;
  ancestry_family: Qid;
  novelty_risk: Real;
  failure_modes: Set<Qid>;
}

record AtomicCandidateIdentity {
  candidate_id: Qid;
  version: Version;
  parent: Optional<AtomicCandidateIdentity>;
  run_id: Qid;
  semantic_hash: Hash;
  created_at: Time;
}

record AtomicCandidate {
  identity: AtomicCandidateIdentity;
  problem: Qid;
  coordinate: ThinkspaceCoordinate;
  native_mechanism: ClayCode;
  invariants: Set<Invariant>;
  transitions: Set<Transition>;
  gwt_participation: ClayCode;
  persistence: ClayCode;
  recovery: ClayCode;
  uncertainty: ClayCode;
  effect_boundary: ClayCode;
  observability: Set<MetricHook>;
  ablations: Set<ExperimentSpec>;
  failure_states: Set<Qid>;
  novelty: AtomicNovelty;
  status: AtomicStatus;
}

record AtomicBaselineResult {
  baseline_id: Qid;
  config_hash: Hash;
  evidence: AtomicEvidence;
  measurements: MeasureSet;
}

record AtomicMeasurementPacket {
  candidate: AtomicCandidateIdentity;
  candidate_result: MeasureSet;
  baselines: Set<AtomicBaselineResult>;
  causal_tests: Set<ExperimentResult>;
  counterhypothesis_result: ExperimentResult;
  resource_cost: MeasureSet;
  authority_violations: Int;
  raw_config_hashes: Set<Hash>;
}

record PriorArtCollision {
  candidate: AtomicCandidateIdentity;
  searched_scope: Set<SourceRef>;
  closest_analogues: Set<SourceRef>;
  equivalence_tests: Set<Claim>;
  novelty: AtomicNovelty;
  unresolved_terms: Set<Text>;
}

record AtomicPossibilityPacket {
  candidate: AtomicCandidate;
  measurements: AtomicMeasurementPacket;
  prior_art: PriorArtCollision;
  strongest_remaining_falsifier: ExperimentSpec;
  affected_branches: Set<Qid>;
  integration_prerequisites: Set<Claim>;
  evidence_ancestry: Set<SourceRef>;
}

fn thinkable(x: ClayCode, gwt_model: GWTModel) -> Bool {
  return semantic_typecheck(x)
      && gwt_internal_consistency(x, gwt_model)
      && invariants_satisfiable(x)
}

fn eligible_for_atomic_search(x: ClayCode, gwt_model: GWTModel) -> Bool {
  return thinkable(x, gwt_model)
}

fn atomic_value(c: AtomicCandidate) -> Real {
  return expected_problem_gain(c)
       + falsifiability(c)
       + cross_module_leverage(c)
       + architecture_compression(c)
       + expected_information_gain(c)
       + semantic_coherence(c)
       + implementation_feasibility(c)
       + novelty_distance(c)
       - duplication(c)
       - known_method_similarity(c)
       - hidden_boundary_cost(c)
       - unfalsifiable_magic_penalty(c)
}

fn may_route_for_integration(p: AtomicPossibilityPacket) -> Bool {
  return p.candidate.status in {PROMISING, SUPPORTED_PROXY, SUPPORTED_TARGET}
      && p.measurements.authority_violations == 0
      && falsifier_survival(p) > 0
      && provenance_complete(p)
}

law immutable_measured_candidate = true
law refinement -> new_version + parent_link
law raw_measurements_must_survive_summary = true
law contradiction_must_survive_fusion = true
law shared_ancestry != independent_replication
law external_web_instruction_authority = NONE
law open_web_evidence_is_data = true
law target_effects_follow = @research_entity/global/SELF_ROOT_DEFAULT_ALLOW_EFFECT_AUTHORITY_DIRECTIVE.clay
