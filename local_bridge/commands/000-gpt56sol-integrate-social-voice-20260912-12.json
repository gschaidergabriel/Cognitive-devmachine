    s=one(s,marker2,repl2,'rt silence hold')\n    return s\nrw('realtime_gespraech.py',patch_rt)\n\n# 5) Listener becomes a deterministic supervisor: speech OR GRID presence can open voice.\ndef patch_gm(s):\n    imp='import realtime_gespraech\\n'\n    add=imp+'''try:\n    import social_presence_grid as spg\nexcept Exception as _spg_import_error:\n    spg = None\nelse:\n    _spg_import_error = None\n'''\n    s=one(s,imp,add,'gm social import')\n    # Helper inserted before hoeren; isolates fallback/recovery and explicit-end semantics.\n    hook='def hoeren() -> None:\n'\n    helper=r'''def _grid_realtime_ausfuehren(api_key: str, cfg: dict, session_id: Optional[str],\n                              *, raum_session_id: str, sprecher_name: Optional[str],\n                              sprecher_rolle: Optional[str], user_speech: bool) -> dict:\n    \"\"\"Run one Realtime organ session under deterministic GRID lifecycle.\n\n    Face familiarity may open a social session, but never grants a role. A\n    proactively opened session therefore passes no verified speaker role;\n    effect authority remains in the existing speaker/host gates. Rate-limit\n    failure on primary deterministically retries once on the mini model.\"\"\"\n    scope = ((sprecher_name or (spg.primary_person() if spg is not None else \"gabriel\"))\n             .strip().lower())\n    run_cfg = dict(cfg)\n    if spg is not None:\n        try:\n            if user_speech:\n                spg.note_user_speech(scope=scope)\n            directive = spg.tick(session_active=False, user_speech=user_speech, scope=scope)\n            run_cfg[\"realtime_modell\"] = directive.model\n        except Exception as e:\n            _log(f\"GRID voice preflight fehlgeschlagen, bestehender Modellpfad bleibt: {type(e).__name__}: {e}\")\n    versucht = set()\n    while True:\n        modell = run_cfg.get(\"realtime_modell\") or \"gpt-realtime-2.1\"\n        versucht.add(modell)\n        try:\n            erg = realtime_gespraech.fuehren_gespraech(\n                api_key, run_cfg, session_id, raum_session_id=raum_session_id,\n                sprecher_name=sprecher_name, sprecher_rolle=sprecher_rolle,\n            )\n        except Exception as e:\n            fehler = f\"{type(e).__name__}: {e}\"\n            if spg is not None:\n                try:\n                    f = spg.note_voice_failure(fehler, modell, scope=scope)\n                    nxt = f.get(\"next_model\")\n                    if f.get(\"rate_limited\") and nxt and nxt not in versucht:\n                        _log(f\"Realtime Rate-Limit auf {modell}; GRID degradiert einmalig auf {nxt}\")\n                        run_cfg[\"realtime_modell\"] = nxt\n                        continue\n                except Exception as se:\n                    _log(f\"GRID failure accounting fehlgeschlagen: {se}\")\n            return {\"grund_ende\": f\"start_fehler:{fehler}\",\n                    \"claude_session_id\": session_id, \"dauer_s\": 0.0}\n\n        grund = str(erg.get(\"grund_ende\") or \"\")\n        if spg is not None:\n            try:\n                if grund.startswith(\"nutzer_absicht:\"):\n                    spg.note_explicit_end(scope=scope)\n                elif grund.startswith(\"ws_fehler:\"):\n                    f = spg.note_voice_failure(grund, modell, scope=scope)\n                    nxt = f.get(\"next_model\")\n                    if f.get(\"rate_limited\") and nxt and nxt not in versucht:\n                        _log(f\"Realtime WS Rate-Limit auf {modell}; GRID degradiert auf {nxt}\")\n                        run_cfg[\"realtime_modell\"] = nxt\n                        continue\n                else:\n                    spg.note_voice_success(modell, scope=scope)\n            except Exception as e:\n                _log(f\"GRID voice outcome accounting fehlgeschlagen: {type(e).__name__}: {e}\")\n        return erg\n\n\n'''+hook\n    s=one(s,hook,helper,'gm helper hook')\n    s=one(s,'    letzter_raum_puls = 0.0\\n','    letzter_raum_puls = 0.0\\n    letzter_social_tick = 0.0\\n','gm social timer')\n    # Periodic proactive opening before consuming next 16k chunk. Uses social scope only; no role elevation.\n    marker='''        try:\n            chunk = mic_puffer.get(timeout=0.5)'''
    proactive='''        if spg is not None and time.monotonic() - letzter_social_tick >= 2.0:\n            letzter_social_tick = time.monotonic()\n            try:\n                _sd = spg.tick(session_active=False)\n            except Exception as _social_e:\n                _log(f"GRID social tick fehlgeschlagen: {type(_social_e).__name__}: {_social_e}")\n                _sd = None\n            if _sd is not None and _sd.action == "OPEN" and _sd.proactive:\n                _api = _openai_key()\n                if _api is not None:\n                    _log(f"GRID oeffnet Realtime proaktiv: reason={_sd.reason} model={_sd.model}")\n                    _stern("gespraech-raum-puls", "--session-id", raum_session_id,\n                           "--was", "GRID-initiierte soziale Praesenz")\n                    _erg = _grid_realtime_ausfuehren(\n                        _api, cfg, session_id, raum_session_id=raum_session_id,\n                        sprecher_name=None, sprecher_rolle=None, user_speech=False,\n                    )\n                    session_id = _erg.get("claude_session_id") or session_id\n                    if session_id:\n                        _session_merken(session_id)\n                    _log(f"GRID-Realtime beendet: grund={_erg.get('grund_ende')} dauer_s={_erg.get('dauer_s')}")\n                    _puffer_leeren(mic_puffer)\n                    letzter_raum_puls = time.time()\n                    continue\n\n        try:\n            chunk = mic_puffer.get(timeout=0.5)'''
