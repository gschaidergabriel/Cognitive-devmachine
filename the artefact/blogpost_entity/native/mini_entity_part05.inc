}
static json_object*native_profile_source(json_object*profile,const char*kind){json_object*a=jget(profile,"sources");if(!a||json_object_get_type(a)!=json_type_array)return NULL;for(size_t i=0;i<json_object_array_length(a);i++){json_object*s=json_object_array_get_idx(a,(int)i);if(s&&json_object_get_type(s)==json_type_object&&!strcmp(jstr(s,"kind",""),kind))return s;}return NULL;}
static json_object*native_source_slot(json_object*sources,json_object*sensors,json_object*profile,const char*kind,int sensor_ok){json_object*slot=jget(sources,kind);if(slot)return slot;json_object*spec=native_profile_source(profile,kind);slot=json_object_new_object();json_object_object_add(slot,"ok",json_object_new_boolean(sensor_ok));json_object_object_add(slot,"rows",json_object_new_array());json_object_object_add(slot,"value",NULL);json_object_object_add(slot,"evidence_prefix",json_object_new_string(spec?jstr(spec,"evidence_prefix",""):""));json_object_object_add(slot,"required_for_quiet",json_object_new_boolean(spec?native_bool(spec,"required_for_quiet",0):0));json_object_object_add(sources,kind,slot);json_object*sen=json_object_new_object();json_object_object_add(sen,"ok",json_object_new_boolean(sensor_ok));json_object_object_add(sensors,kind,sen);return slot;}
static void native_add_ref(json_object*a,const char*s){if(!s||!*s||arr_has(a,s))return;json_object_array_add(a,json_object_new_string(s));}
static int native_compile(json_object*profile,const packet_t*p,native_compiled_t*out){memset(out,0,sizeof *out);if(!profile||!p)return 0;json_object*sources=json_object_new_object(),*sensors=json_object_new_object(),*probes=json_object_new_object();
    json_object*configured=jget(profile,"sources");if(configured&&json_object_get_type(configured)==json_type_array){for(size_t i=0;i<json_object_array_length(configured);i++){json_object*spec=json_object_array_get_idx(configured,(int)i);const char*kind=jstr(spec,"kind",NULL);if(kind&&*kind)native_source_slot(sources,sensors,profile,kind,p->sensor_ok);}}
    for(size_t i=0;i<p->n;i++){json_object*slot=native_source_slot(sources,sensors,profile,p->v[i].kind,p->sensor_ok);json_object*rows=jget(slot,"rows"),*row=json_object_new_object();json_object_object_add(row,"source_id",json_object_new_string(p->v[i].id));json_object*payload=parse_json(p->v[i].payload);if(payload&&json_object_get_type(payload)==json_type_object){json_object_object_foreach(payload,k,v){if(strcmp(k,"source_id"))json_object_object_add(row,k,json_object_get(v));}json_object_put(payload);}else{if(payload)json_object_put(payload);json_object_object_add(row,"payload",json_object_new_string(p->v[i].payload));}json_object_array_add(rows,row);}
    json_object*probe_specs=jget(profile,"canonical_probes");if(probe_specs&&json_object_get_type(probe_specs)==json_type_array){for(size_t i=0;i<json_object_array_length(probe_specs);i++){json_object*spec=json_object_array_get_idx(probe_specs,(int)i);const char*name=jstr(spec,"name",NULL);if(!name||!*name)continue;json_object*pr=json_object_new_object();json_object_object_add(pr,"ok",json_object_new_boolean(0));json_object_object_add(pr,"rows",json_object_new_array());json_object_object_add(pr,"evidence_ref",json_object_new_string(jstr(spec,"evidence_ref","")));json_object_object_add(probes,name,pr);}}
    json_object*ctx=json_object_new_object(),*derived=json_object_new_object();json_object_object_add(derived,"source_count",json_object_new_int64((int64_t)p->n));json_object_object_add(derived,"quiet_sensors_ok",json_object_new_boolean(p->sensor_ok));json_object_object_add(ctx,"derived",derived);json_object_object_add(ctx,"sources",json_object_get(sources));json_object_object_add(ctx,"sensors",json_object_get(sensors));json_object_object_add(ctx,"probes",json_object_get(probes));
