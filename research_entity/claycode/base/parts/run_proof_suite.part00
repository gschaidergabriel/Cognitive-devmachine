from __future__ import annotations
import hashlib, json, random, tempfile, traceback
from pathlib import Path
from claycode_base import *

OUT=Path(__file__).resolve().parent

APPS = {
'APP-01-CLI': ('''module app.cli
fn main(text : String) -> Int {
  let n = host.file.write("input.txt", text)
  let reread = host.file.read("input.txt")
  require n == len(reread)
  return len(reread)
}''', ['fs'], ['file'], ['ClayCode']),
'APP-02-HTTP-WEBSITE': ('''module app.http
fn main() -> String {
  return host.http.roundtrip("/", "<h1>ClayCode</h1>")
}''', ['net'], ['http'], []),
'APP-03-DB-SERVICE': ('''module app.db
fn main() -> Int {
  let a = host.db.transaction("counter", 5)
  let b = host.db.transaction("counter", 7)
  return b
}''', ['db'], ['db'], []),
'APP-04-CONCURRENT-SERVICE': ('''module app.concurrent
fn main() -> Int {
  let total = host.concurrent.sum(25)
  let c = host.concurrent.cancel()
  require c == "cancelled"
  let atomic = host.concurrent.atomic_increment(4, 500)
  require atomic == 2000
  return total
}''', ['concurrency'], ['concurrent'], []),
'APP-05-GUI-INTERACTIVE': ('''module app.ui
fn main() -> String {
