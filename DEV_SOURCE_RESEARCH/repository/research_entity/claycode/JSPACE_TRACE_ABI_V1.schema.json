{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clay:entityos:hcu:jspace-trace-abi:v1",
  "title": "JSPACE_TRACE_ABI/v1",
  "description": "Machine-readable source contract for model-local J-Space observation/control trace envelopes. This schema does not grant canonical truth, model-runtime, HCU-full, J-Space-model or training credit.",
  "type": "object",
  "required": [
    "schema",
    "causal_event_id",
    "admission_id",
    "generation",
    "model_id",
    "model_revision",
    "checkpoint_sha256",
    "tokenizer_sha256",
    "runtime_build_sha256",
    "loader_consumption_identity",
    "inference_receipt_id",
    "jspace_adapter_id",
    "activation_site",
    "token_position_policy",
    "observation_class",
    "activation_or_projection_sha256",
    "semantic_family_id",
    "task_family_id",
    "context_polarity_id",
    "split_id",
    "intervention_id",
    "control_class",
    "target_metrics",
    "off_target_metrics",
    "result_classification",
    "credit_scope"
  ],
  "properties": {
    "schema": {"const": "JSPACE_TRACE_ABI/v1"},
    "causal_event_id": {"type": "string", "minLength": 1},
    "admission_id": {"type": "string", "minLength": 1},
    "generation": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "loader_consumption_identity": {"oneOf": [{"const": "UNKNOWN"}, {"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "inference_receipt_id": {"type": "string", "minLength": 1},
    "jspace_adapter_id": {"type": "string", "minLength": 1},
    "activation_site": {"type": "object", "minProperties": 1},
    "token_position_policy": {"type": "string", "minLength": 1},
    "observation_class": {"enum": ["RAW_ACTIVATION_MEASUREMENT", "PROJECTED_LATENT_MEASUREMENT", "JACOBIAN_OR_READOUT_MEASUREMENT", "PROBE_SCORE_MEASUREMENT", "WORKSPACE_CANDIDATE_MEASUREMENT"]},
    "activation_or_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_family_id": {"type": "string", "minLength": 1},
    "task_family_id": {"type": "string", "minLength": 1},
    "context_polarity_id": {"type": "string", "minLength": 1},
    "split_id": {"enum": ["CALIBRATION", "DEV", "CAUSAL_HOLDOUT", "OOD_HOLDOUT"]},
    "intervention_id": {"type": "string", "minLength": 1},
    "control_class": {"type": "string", "minLength": 1},
    "target_metrics": {"oneOf": [{"type": "array"}, {"type": "object"}]},
    "off_target_metrics": {"oneOf": [{"type": "array"}, {"type": "object"}]},
    "result_classification": {"type": "string", "minLength": 1},
    "credit_scope": {"type": "string", "minLength": 1},
    "canonical_truth": {"const": false},
    "truth_status": {"const": "CANDIDATE_MEASUREMENT_ONLY"}
  },
  "additionalProperties": true
}
