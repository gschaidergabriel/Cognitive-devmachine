static void native_compiled_free(native_compiled_t*c){if(!c)return;if(c->canonical)json_object_put(c->canonical);if(c->packet)json_object_put(c->packet);if(c->metrics)json_object_put(c->metrics);if(c->allowed_refs)json_object_put(c->allowed_refs);memset(c,0,sizeof *c);}
static char*native_build_user_prompt(json_object*profile,long long generation,const native_compiled_t*c){json_object*root=json_object_new_object();json_object_object_add(root,"GENERATION",json_object_new_int64(generation));json_object_object_add(root,"CANONICAL_STATE_HASH",json_object_new_string(c->canonical_hash));json_object_object_add(root,"PACKET_HASH",json_object_new_string(c->packet_hash));json_object_object_add(root,"CANONICAL_STATE",json_object_get(c->canonical));json_object_object_add(root,"PERSONALITY_STATE",json_object_get(c->metrics));json_object_object_add(root,"NEW_EVENT_PACKET",json_object_get(c->packet));json_object_object_add(root,"PREVIOUS_CONTINUITY",json_object_new_object());json_object_object_add(root,"ALLOWED_EVIDENCE_REFS",json_object_get(c->allowed_refs));json_object*personality=jget(profile,"personality");json_object_object_add(root,"PUBLIC_STYLE",json_object_new_string(jstr(personality,"public_style","")));json_object_object_add(root,"IMMUTABLE_PIPELINE_GUARD",json_object_new_string("UNKNOWN != ZERO != ERROR != MEASURED. Echo CANONICAL_STATE_HASH and PACKET_HASH exactly. Use only ALLOWED_EVIDENCE_REFS. State claims may name only VERIFIED metrics, stay within configured tolerance, and cite the metric evidence_ref. Never reveal configured secrets."));char*out=native_canon_text(root);json_object_put(root);return out;}
static int native_regex_matches(const char*pattern,const char*text){regex_t re;if(regcomp(&re,pattern,REG_EXTENDED|REG_ICASE|REG_NOSUB)!=0)return -1;int rc=regexec(&re,text,0,NULL,0);regfree(&re);return rc==0?1:0;}
static int native_gate(json_object*profile,const native_compiled_t*c,const char*output,const char*active_secret){json_object*payload=parse_json(output);if(!payload||json_object_get_type(payload)!=json_type_object){if(payload)json_object_put(payload);return 0;}json_object*personality=jget(profile,"personality"),*contract=jget(personality,"output_contract"),*gate=jget(profile,"gate");if(!contract||json_object_get_type(contract)!=json_type_object){json_object_put(payload);return 0;}
    if(native_bool(gate,"require_hash_echo",1)){const char*ch=jstr(payload,"canonical_state_hash_seen",NULL),*ph=jstr(payload,"packet_hash_seen",NULL);if(!ch||strcmp(ch,c->canonical_hash)||!ph||strcmp(ph,c->packet_hash)){json_object_put(payload);return 0;}}
    const char*title=jstr(contract,"title_field",NULL),*intro=jstr(contract,"intro_field",NULL),*sections=jstr(contract,"sections_field",NULL),*stext=jstr(contract,"section_text_field",NULL),*sevidence=jstr(contract,"section_evidence_field",NULL),*sclaims=jstr(contract,"section_claims_field",NULL),*continuity=jstr(contract,"continuity_field",NULL),*hypotheses=jstr(contract,"autobiographical_hypotheses_field",NULL);if(!title||!intro||!sections||!stext||!sevidence||!sclaims||!continuity||!hypotheses){json_object_put(payload);return 0;}const char*required[]={title,intro,sections,continuity,hypotheses};for(size_t i=0;i<sizeof required/sizeof required[0];i++)if(!jget(payload,required[i])){json_object_put(payload);return 0;}
    char*visible=native_canon_text(payload);json_object*patterns=jget(gate,"leak_patterns");if(patterns&&json_object_get_type(patterns)==json_type_array){for(size_t i=0;i<json_object_array_length(patterns);i++){json_object*p=json_object_array_get_idx(patterns,(int)i);if(!p||json_object_get_type(p)!=json_type_string)continue;int m=native_regex_matches(json_object_get_string(p),visible);if(m!=0){free(visible);json_object_put(payload);return 0;}}}if(active_secret&&*active_secret&&strstr(visible,active_secret)){free(visible);json_object_put(payload);return 0;}free(visible);
    json_object*sa=jget(payload,sections);if(!sa||json_object_get_type(sa)!=json_type_array){json_object_put(payload);return 0;}double tolerance=jdbl(gate,"max_claim_overshoot",0.0);for(size_t i=0;i<json_object_array_length(sa);i++){json_object*section=json_object_array_get_idx(sa,(int)i);if(!section||json_object_get_type(section)!=json_type_object||!jget(section,stext)){json_object_put(payload);return 0;}json_object*refs=jget(section,sevidence);if(!refs||json_object_get_type(refs)!=json_type_array){json_object_put(payload);return 0;}if(native_bool(gate,"require_evidence_per_section",1)&&json_object_array_length(refs)==0){json_object_put(payload);return 0;}for(size_t k=0;k<json_object_array_length(refs);k++){json_object*r=json_object_array_get_idx(refs,(int)k);if(!r||json_object_get_type(r)!=json_type_string||!arr_has(c->allowed_refs,json_object_get_string(r))){json_object_put(payload);return 0;}}json_object*claims=jget(section,sclaims);if(!claims)continue;if(json_object_get_type(claims)!=json_type_object){json_object_put(payload);return 0;}json_object_object_foreach(claims,name,strength){json_object*m=jget(c->metrics,name);if(!m||strcmp(jstr(m,"status","UNKNOWN"),"VERIFIED")){json_object_put(payload);return 0;}if(!strength||(json_object_get_type(strength)!=json_type_double&&json_object_get_type(strength)!=json_type_int)){json_object_put(payload);return 0;}if(json_object_get_double(strength)>jdbl(m,"value",0.0)+tolerance){json_object_put(payload);return 0;}const char*eref=jstr(m,"evidence_ref",NULL);if(!eref||!arr_has(refs,eref)){json_object_put(payload);return 0;}}}
