    json_object*packet=json_object_new_object();json_object_object_add(packet,"sources",json_object_get(sources));json_object_object_add(packet,"source_count",json_object_new_int64((int64_t)p->n));json_object_object_add(packet,"quiet_sensors_ok",json_object_new_boolean(p->sensor_ok));
