{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"canonical.schema.json",
  "type":"object",
  "required":["schema_version","entity_id","entity_version","revision","state_hash","status","sync_status"],
  "properties":{
    "schema_version":{"type":"string"},
    "entity_id":{"type":"string","minLength":1},
    "entity_version":{"const":"RAE-8.8"},
    "revision":{"type":"integer","minimum":0},
    "parent_revision":{"type":"integer","minimum":0},
    "parent_state_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "state_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "updated_at":{"type":"string"},
    "updated_by_instance":{"type":"string"},
    "project_id_or_scope":{"type":"string"},
    "constitution_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "semantic_anchor_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "world_model_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "self_model_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "active_experiment_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "active_hypothesis_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "critical_negative_result_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "open_contradiction_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "architecture_frontier":{"type":"array","items":{"type":"string"}},
    "goodhart_tripwires":{"type":"array","items":{"type":"string"}},
    "next_actions_ranked":{"type":"array","items":{"type":"string"}},
    "status":{"type":"string","minLength":1},
    "sync_status":{"type":"string","minLength":1},
    "clay_generation":{"type":"integer","minimum":0},
    "auto_boot_guaranteed":{"type":"boolean"}
  },
  "additionalProperties":true
}
