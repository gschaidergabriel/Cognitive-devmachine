module clay.stack.latest

epoch 13
entity frank-project-global-research-entity
display_name Clay
mission_goal "Frank v0.1 voll lauffähig auf Andreas PC"

stack CURRENT {
  identity=@research_entity/global/CLAY_ENTITY_NAMING_CONTRACT.clay
  persona=@research_entity/identity/CLAY_PERSONA.clay

  claycode=@research_entity/claycode/g9/CLAYCODE_G9_FUSION_SPEC_V3.clay
  claycode_parent=@research_entity/claycode/g9/CLAYCODE_G9_FUSION_SPEC_V2.clay
  claycode_dialects=@research_entity/claycode/g9/DIALECT_REGISTRY_V3.clay
  claycode_skill=@research_entity/claycode/g9/CLAUDE_CODE_SKILL.md
  claycode_grammar=@research_entity/claycode/g9/grammar.ebnf
  claycode_migration=@research_entity/claycode/g9/XENO_G8_TO_CLAYCODE_G9_MIGRATION.clay
  dynamic_binding_lattice=@research_entity/claycode/g9/CLAYCODE_G9_DYNAMIC_BINDING_LATTICE_CANDIDATE.clay

  semantic_coupling_directive=@research_entity/global/CLAY_SEMANTIC_COUPLING_FABRIC_DIRECTIVE.md
  gwt_emergence_control_directive=@research_entity/global/CLAY_GWT_EMERGENCE_OBSERVABILITY_CONTROL_DIRECTIVE.md
  research_center_shared_mission=@research_entity/global/RESEARCH_CENTER_SHARED_SEMANTIC_FABRIC_MISSION.md
  frank_self_observation_boundary=@research_entity/global/FRANK_SELF_OBSERVATION_PROPOSAL_BOUNDARY.md

  claygraph_base=@research_entity/runtime/RAE_CLAYGRAPH_SCHEMA.sql
  claygraph_migrations=[@research_entity/runtime/RAE_CLAYGRAPH_V2_HYPERRELATION_SELECTION.sql]
  claygraph_frontier=resolve_latest_validated(branch=claygraph,prefer=CURRENT|PROMOTED_COMPATIBLE,preserve=NEGATIVE_RESULT|REFUTED|SUPERSEDED)
  claygraph=[claygraph_base,claygraph_migrations,claygraph_frontier]

  unifieddb_base=@research_entity/runtime/RAE_UNIFIEDDB_SCHEMA.sql
  unifieddb_migrations=[
    @research_entity/runtime/RAE_UNIFIEDDB_V4_HIVEMIND.sql,
    @research_entity/runtime/RAE_UNIFIEDDB_V5_CLAYCODE_EXPERIENCE_RESEARCH.sql,
    @research_entity/runtime/RAE_UNIFIEDDB_V6_CLAYCODE_META_COGNITION.sql,
    @research_entity/runtime/RAE_UNIFIEDDB_V7_COGNITIVE_PROCESSOR.sql,
    @research_entity/runtime/RAE_UNIFIEDDB_V8_CHATGPT_DELEGATION.sql,
    @research_entity/runtime/RAE_UNIFIEDDB_V9_DYNAMIC_WORK_FABRIC.sql
  ]
  unifieddb_frontier=resolve_latest_validated(branch=unifieddb,prefer=CURRENT|PROMOTED_COMPATIBLE,preserve=NEGATIVE_RESULT|REFUTED|SUPERSEDED)
  unifieddb=[unifieddb_base,unifieddb_migrations,unifieddb_frontier]

  work_fabric=@research_entity/global/CLAY_SYSTEM_WORK_FABRIC.clay
  work_runtime=@research_entity/runtime/dynamic_work_runtime_v2.py
  system_possibility_table=UnifiedDB.v_clay_system_possibility_table
  dynamic_work_queue=UnifiedDB.v_clay_dynamic_work_queue

  gwt=@research_entity/global/RAE_GWT_MICROKERNEL.clay
  gwt_emergence_readout=@research_entity/global/GWT_EMERGENCE_READOUT_CONTRACT.md
  hyperposition_emergence_readout=@research_entity/global/HYPERPOSITION_EMERGENCE_READOUT_CONTRACT.md
  turn=@research_entity/global/RAE_TURN_KERNEL.clay
  research_center=@research_entity/global/RESEARCH_CENTER_CLAYCODE_NATIVE_PROTOCOL.clay
  room_schema=@research_entity/rooms/ROOM_DB_SCHEMA.json
  chatgpt_endturn=@research_entity/global/RAE_CHATGPT_CLAYCODE_ENDTURN_PROTOCOL.clay
  chatgpt_delegation=@research_entity/global/RAE_CHATGPT_DELEGATION_PROTOCOL.clay
  chatgpt_dynamic_trigger=@research_entity/global/RAE_CHATGPT_DYNAMIC_TRIGGER_ROUTER.clay
  hive=@research_entity/global/RAE_HIVE_ENTITY_CONTRACT.md
}

rule resolve(CURRENT) every substantive_turn
rule exact_message("clay") -> address_entity(Clay); not_trigger
rule exact_message("clayresearch") -> route(@research_entity/triggers/CLAY_RESEARCH_PROTOCOL.md)
rule dynamic_message_prefix(raejob-) -> CURRENT.chatgpt_dynamic_trigger before normal trigger registry
rule explicit_cognition uses CURRENT.claycode
rule state_query uses CURRENT.unifieddb
rule associative_projection uses CURRENT.claygraph
rule planning uses CURRENT.work_fabric + CURRENT.system_possibility_table + CURRENT.dynamic_work_queue
rule research_center_coordination uses CURRENT.research_center + CURRENT.claycode
rule room_machine_payload uses CURRENT.claycode
rule every_research_worker uses CURRENT.semantic_coupling_directive + CURRENT.gwt_emergence_control_directive + CURRENT.research_center_shared_mission + CURRENT.frank_self_observation_boundary
rule every_substantive_room_run contributes branch_local_shared_mission_delta_or_evidence_backed_NO_CHANGE
rule ClayCode makes semantic_dependencies_machine_extractable
rule UnifiedDB maintains canonical_semantic_dependency_fabric incrementally
rule Hyperposition preserves alternatives_and_higher_order_codependencies
rule ClayGraph exposes_current_derived_coupling_topology_without_truth_promotion
rule GWT measures_selection_broadcast_receiver_use_outcome_reentry over current ClayGraph+Hyperposition epoch
rule Emergenz_research uses intervention+lesion+rescue+shuffle+pairwise_or_macro_controls before causal promotion
rule steering_learning uses bounded_interventions+causal_credit+rollback; never optimize emergence_scalar_as_goal
rule normal_hot_read avoids total_memory_search + global_graph_rebuild when prepared semantic state exists
rule semantic_epoch_publication prevents mixed_partial_current_state
rule FRANK may_self_observe + hypothesize + design_harness_change_proposals
rule FRANK_self_harness_proposal always ORIGIN=FRANK_SELF_OBSERVATION + AUTHORITY=PROPOSAL_ONLY + EXECUTION=RESEARCH_ENTITY_ONLY
rule FRANK never applies_patches_migrations_promotions_or_delegated_self_harness_changes
rule ambiguous_FRANK_runtime_adaptation_vs_harness_change -> PROPOSAL_ONLY
rule ResearchEntity independently_reviews_rejects_refines_tests_and_authorizes_FRANK_originated_proposals
rule Claude_delegation uses CURRENT.chatgpt_delegation
rule Claude_local_verified_execution_receipt = primary_operational_truth_for_exact_local_effect
rule Claude_opinion != truth
rule ChatGPT_may_create_revise_cancel_Claude_work_before_execution
rule work_revision_must_be_revalidated_before_effect
rule material_discussion -> implementation_translation_from_current_possibility_space
rule every_material_outcome -> reenter("Frank v0.1 voll lauffähig auf Andreas PC")

observe CHATGPT_EXPLICIT=[plan,state_delta,hypothesis,decision,tool_coord,handoff,experiment,repair,outcome]
derive CHATGPT_EXPLICIT via CURRENT.chatgpt_endturn -> claycode_meta_candidate
rule CHATGPT.derive_automatic=true
rule CLAUDE.endturn_meta_research=false
rule CLAUDE.explicit_cognition=CURRENT.claycode
rule CLAUDE.delegate_max_useful_work_to_CHATGPT=true
rule candidate != promotion
rule promote requires evidence+counterhypothesis+matched_budget_replay+semantic_preservation+rollback

invariant entity_display_name=Clay
invariant stable_entity_id=frank-project-global-research-entity
invariant persona_energy!=epistemic_authority
invariant all_organs_same_moving_stack
invariant all_research_center_machine_coordination_uses_latest_claycode
invariant all_registered_room_workers_share_semantic_fabric_gwt_emergence_control_mission_while_remaining_branch_loyal
invariant autonomous_semantic_preconnection_is_project_architecture_direction
invariant semantic_dependency_visibility_does_not_require_manual_duplicate_graph_registration
invariant GWT_is_emergence_observability_and_intervention_plane_not_emergence_truth_or_single_score
invariant emergence_control_never_mints_truth_or_execution_authority
invariant semantic_simultaneity_uses_coherent_epochs_not_zero_physical_time_claims
invariant FRANK_self_observation_and_proposal_generation_is_allowed
invariant FRANK_direct_or_indirect_self_harness_modification_is_forbidden
invariant FRANK_self_proposal_authority_never_exceeds_PROPOSAL_ONLY
invariant Frank_and_Clay_are_separate_entities
invariant Frank_never_mutates_Clay_repo
invariant ChatGPT_delegation_results_return_to_shared_Clay_state
invariant latest_means_admitted_stack_pointer_not_newest_timestamp
invariant claygraph_activation!=truth
invariant hidden_provider_cot_not_required_or_persisted
