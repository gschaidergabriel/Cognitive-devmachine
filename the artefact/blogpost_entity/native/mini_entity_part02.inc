typedef struct {buf_t b;} curl_buf;
static size_t curl_write_cb(char*ptr,size_t sz,size_t nm,void*ud){curl_buf*c=ud;size_t n=sz*nm;if(c->b.n+n>MAX_TEXT)return 0;buf_addn(&c->b,ptr,n);return n;}
static int host_boundary(char c){return c==0||c=='/'||c==':'||c=='?'||c=='#';}
static int http_host_is(const char*u,const char*host){const char*pfx="http://";size_t pn=strlen(pfx),hn=strlen(host);if(strncmp(u,pfx,pn))return 0;const char*h=u+pn;return !strncmp(h,host,hn)&&host_boundary(h[hn]);}
static int is_loopback_http(const char*u){return http_host_is(u,"127.0.0.1")||http_host_is(u,"localhost")||http_host_is(u,"[::1]");}
static char *token_from_profile(json_object*inf,const char*secret_file){if(secret_file&&*secret_file){char*p=read_file(secret_file,65536);if(p){char*e=p+strlen(p);while(e>p&&(e[-1]=='\n'||e[-1]=='\r'||e[-1]==' '||e[-1]=='\t'))*--e=0;return p;}}json_object*a=jget(inf,"secret_names");if(a&&json_object_get_type(a)==json_type_array){int n=json_object_array_length(a);for(int i=0;i<n;i++){json_object*v=json_object_array_get_idx(a,i);if(v&&json_object_get_type(v)==json_type_string){const char*x=getenv(json_object_get_string(v));if(x&&*x)return xstrdup(x);}}}return NULL;}
static char *run_api(json_object*inf,const char*system,const char*user,const char*secret_file,char**token_out){const char*endpoint=jstr(inf,"endpoint",NULL),*model=jstr(inf,"model",NULL);if(!endpoint||!model)return NULL;if(!strncmp(endpoint,"http://",7)&&!is_loopback_http(endpoint))return NULL;char*token=token_from_profile(inf,secret_file);json_object*secrets=jget(inf,"secret_names");int token_required=secrets&&json_object_get_type(secrets)==json_type_array&&json_object_array_length(secrets)>0&&!is_loopback_http(endpoint);if(token_required&&!token){free(token);return NULL;}json_object*root=json_object_new_object(),*msgs=json_object_new_array();json_object_object_add(root,"model",json_object_new_string(model));json_object*m1=json_object_new_object();json_object_object_add(m1,"role",json_object_new_string("system"));json_object_object_add(m1,"content",json_object_new_string(system?system:""));json_object_array_add(msgs,m1);json_object*m2=json_object_new_object();json_object_object_add(m2,"role",json_object_new_string("user"));json_object_object_add(m2,"content",json_object_new_string(user));json_object_array_add(msgs,m2);json_object_object_add(root,"messages",msgs);json_object_object_add(root,"temperature",json_object_new_double(jdbl(inf,"temperature",0.2)));json_object_object_add(root,"max_tokens",json_object_new_int(jint(inf,"max_tokens",1200)));const char*body=json_object_to_json_string_ext(root,JSON_C_TO_STRING_PLAIN);CURL*c=curl_easy_init();if(!c){json_object_put(root);free(token);return NULL;}curl_buf cb;buf_init(&cb.b);struct curl_slist*headers=NULL;headers=curl_slist_append(headers,"Content-Type: application/json");if(token&&*token){const char*hname=jstr(inf,"auth_header","Authorization"),*prefix=jstr(inf,"auth_prefix","Bearer ");buf_t h;buf_init(&h);buf_printf(&h,"%s: %s%s",hname,prefix,token);headers=curl_slist_append(headers,h.p);buf_free(&h);}curl_easy_setopt(c,CURLOPT_URL,endpoint);curl_easy_setopt(c,CURLOPT_HTTPHEADER,headers);curl_easy_setopt(c,CURLOPT_