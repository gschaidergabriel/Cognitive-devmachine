module clay.research.live_fusion_reentry
version "1.0-candidate"
status RESEARCH_CANDIDATE_NOT_PROMOTED

goal="Frank v0.1 voll lauffaehig auf Andreas PC"
state=UnifiedDB
topology=ClayGraph
live_refresh=@research_entity/global/LIVE_KNOWLEDGE_REFRESH_PROTOCOL.md
swarm=@research_entity/global/AUTONOMOUS_SWARM_COORDINATION_DIRECTIVE.clay
web_fabric=@research_entity/global/INTELLIGENT_LIVE_WEB_KNOWLEDGE_FABRIC.clay
work_events=@research_entity/global/CLAY_WORK_EVENT_PROTOCOL.clay
runtime_candidate=@research_entity/runtime/live_fusion_reentry_v1.py

// Problem: current protocols require repeated refresh + targeted distribution, but the
// transport contract does not yet make knowledge-delta delivery, acknowledgement and
// plan re-evaluation first-class observable events. This candidate closes that loop.

law LIVE_FUSION_IS_APPEND_ONLY_CAUSAL_REENTRY=true
law RAW_EVENTS_ARE_PRESERVED=true
law TARGETED_DELIVERY_NOT_BROADCAST_SPAM=true
law DELIVERY_IS_AT_LEAST_ONCE=true
law ACK_IS_IDEMPOTENT=true
law EVENT_IDENTITY_OUTRANKS_PAYLOAD_EQUALITY=true
law PAYLOAD_EQUALITY_NEVER_CANCELS_NEWER_RECORD_VERSION_PROVENANCE_IDENTITY=true
law HIGH_IMPACT_CONFLICT_MUST_BE_ACKED_BEFORE_AFFECTED_NEXT_EFFECT=true
law ORDINARY_RELEVANT_DELTA_REENTERS_AT_NEXT_CHECKPOINT=true
law LOW_RELEVANCE_DELTA_IS_INDEX_ONLY=true
law ROUTING_SCORE_IS_COORDINATION_SUPPORT_NOT_TRUTH=true
law WORKER_ACK_IS_NOT_AGREEMENT_AND_NOT_EVIDENCE_PROMOTION=true

record LiveFusionDelta {
  event_id:Ref
  source:Ref
  source_seq:Int
  source_epoch:Ref
  observed_at:Time
  semantic_keys:Set<Ref>
  affected_branches:Set<Ref>
  affected_work:Set<Ref>
  affected_claims:Set<Ref>
  novelty:NEW|REFINES|CONTRADICTS|CONFIRMS|SUPERSEDES|NO_MATERIAL_CHANGE
  impact:Score
  urgency:Score
  conflict:Bool
  payload_hash:Hash
  provenance_refs:Set<Ref>
  evidence_class:Ref
}

record WorkerReentryDelivery {
  delivery_id:Ref
  event_id:Ref
  worker_id:Ref
  delivery_class:INTERRUPT_NEXT_SAFE_POINT|NEXT_CHECKPOINT|INDEX_ONLY
  relevance:Score
  semantic_reason:Clay
  emitted_at:Time
}

record WorkerReentryAck {
  ack_id:Ref
  event_id:Ref
  worker_id:Ref
  decision:ACCEPT|REPLAN|NO_CHANGE|CONFLICT|DEFER
  plan_revision:Ref
  note:Clay
  acked_at:Time
}

rule incoming_material_delta -> preserve_raw_event
rule incoming_material_delta -> compare_exact_event_id_for_transport_dedupe
rule exact_event_id_duplicate -> do_not_redeliver_duplicate
rule same_payload_hash_with_new_event_id_or_epoch -> preserve_as_distinct_event
rule same_payload_hash_with_new_record_or_version_or_provenance_identity -> preserve_as_distinct_event
rule incoming_material_delta -> fuse_against_current_UnifiedDB+recent_receipts+open_conflicts
rule incoming_material_delta -> ClayGraph.project(semantic_dependencies,current_work,current_claims)
rule route_score uses semantic_overlap+active_work_overlap+impact+urgency+conflict
rule high_impact_conflict+affected_worker -> INTERRUPT_NEXT_SAFE_POINT
rule relevant_nonblocking_delta -> NEXT_CHECKPOINT
rule no_current_overlap -> INDEX_ONLY
rule WorkerReentryDelivery -> durable_delivery_receipt
rule worker_before_next_material_effect -> ingest_pending_interrupts_for_effect_scope
rule pending_interrupt_intersects_effect_scope -> BLOCK_EFFECT_UNTIL_ACK_OR_REPLAN
rule worker_after_ingest -> emit WorkerReentryAck
rule ack.REPLAN -> recompute_work_frontier+plan_revision
rule ack.CONFLICT -> preserve_open_conflict+counterhypothesis_lane
rule ack.NO_CHANGE -> preserve_reason_without_silent_drop
rule worker_or_process_restart -> replay_raw_log+delivery_receipts+acks
rule replay -> redeliver_unacked_relevant_events
rule duplicate_redelivery -> idempotent_by(event_id,worker_id)
rule source_out_of_order -> retain_event+mark_late; never silently discard
rule backpressure -> prioritize INTERRUPT then NEXT_CHECKPOINT; INDEX_ONLY may lag

// Keep Database Pulse and worker-knowledge Pulse distinct. UnifiedDB/ClayGraph projection
// maintenance may compress safe physical work, but coordination cannot erase causal identity
// merely because final content bytes/fingerprints match.
invariant DATABASE_PULSE_EFFECTIVIZATION != WORKER_KNOWLEDGE_REENTRY
invariant CONTENT_ABA_NEVER_ERASES_CAUSAL_REENTRY
invariant DELIVERY_ACK_DOES_NOT_MINT_TRUTH
invariant ROUTER_NEVER_MINTS_EFFECT_AUTHORITY
invariant FRANK_REMAINS_SEPARATE_RESEARCH_SUBJECT
invariant FRANK_NEVER_MUTATES_CLAY

reference_external_patterns {
  replayable_stream_plus_state_checkpoint = "Apache Flink stateful stream processing / checkpoints"
  idempotent_or_transactional_stream_processing = "Apache Kafka delivery semantics"
  ack_redelivery_and_consumer_state = "NATS JetStream consumers"
}

promotion_gate {
  deterministic_unit_tests=PASS
  append_only_replay=PASS
  exact_event_id_dedupe=PASS
  content_ABA_identity_preservation=PASS
  high_impact_conflict_effect_guard=PASS
  ack_idempotence=PASS
  crash_restart_replay=REQUIRED
  concurrent_writer_race=REQUIRED
  UnifiedDB_materialization=REQUIRED
  active_worker_integration=REQUIRED
  latency_resource_benchmark=REQUIRED
  Hostinger_Ubuntu=REQUIRED
}
