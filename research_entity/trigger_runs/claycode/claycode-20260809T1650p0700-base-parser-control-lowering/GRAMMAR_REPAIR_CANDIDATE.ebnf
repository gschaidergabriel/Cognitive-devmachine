(* Non-promoted ClayCode G9 grammar repair candidate derived from executable counterexample. *)

(* Existing program/statement productions remain unchanged except block gains if_stmt. *)
block = "{", { field | statement | if_stmt | action_stmt }, "}" ;
if_stmt = "if", expr, block ;

(* Preserve existing operators and add comparisons already used by G9 V3 source. *)
operator = "="|"!="|"=="|"->"|"|"|"+"|"-"|"*"|"/"|"&&"|"||"|"iff"|"requires"|"in"|"subset_of"|"=>"|"<"|">"|"<="|">=" ;

