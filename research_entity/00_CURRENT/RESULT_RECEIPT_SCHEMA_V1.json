{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"CLAY_FAST_RESULT/v1",
  "title":"Clay fast current-result receipt",
  "type":"object",
  "required":["schema","receipt_id","direction","created_at","observed_head","status","headline"],
  "properties":{
    "schema":{"const":"CLAY_FAST_RESULT/v1"},
    "receipt_id":{"type":"string","minLength":8,"maxLength":160},
    "direction":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,63}$"},
    "created_at":{"type":"string","format":"date-time"},
    "observed_head":{"type":"string","minLength":7,"maxLength":64},
    "status":{"type":"string","minLength":2,"maxLength":80},
    "headline":{"type":"string","minLength":4,"maxLength":500},
    "state":{"type":"string","maxLength":1600},
    "next":{"type":"string","maxLength":800},
    "evidence":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":300}},
    "active":{"type":"object","additionalProperties":false,"properties":{"branch":{"type":"string","maxLength":160},"pr":{"type":"string","maxLength":160},"issue":{"type":"string","maxLength":160},"request":{"type":"string","maxLength":240}}},
    "organ":{"type":"string","maxLength":160}
  },
  "additionalProperties":true
}
