); char now[32];utc_now(now);sqlite3_stmt*s=NULL;sqlite3_prepare_v2(db,"INSERT OR IGNORE INTO entity_state(id,generation,active_profile,created_at,updated_at) VALUES(1,0,NULL,?,?)",-1,&s,NULL);sqlite3_bind_text(s,1,now,-1,SQLITE_TRANSIENT);sqlite3_bind_text(s,2,now,-1,SQLITE_TRANSIENT);sqlite3_step(s);sqlite3_finalize(s); }
static void init_source(sqlite3*db){ sql_exec(db,"CREATE TABLE IF NOT EXISTS mini_entity_events(event_id INTEGER PRIMARY KEY AUTOINCREMENT,source_id TEXT NOT NULL UNIQUE,kind TEXT NOT NULL,payload_json TEXT NOT NULL,created_at TEXT NOT NULL,consumed_generation INTEGER); CREATE INDEX IF NOT EXISTS mini_entity_events_pending ON mini_entity_events(consumed_generation,event_id);"); }
static long long get_generation(sqlite3*db){ sqlite3_stmt*s=NULL; if(sqlite3_prepare_v2(db,"SELECT generation FROM entity_state WHERE id=1",-1,&s,NULL)!=SQLITE_OK)die_sql(db,"GEN_PREP"); long long g=0;if(sqlite3_step(s)==SQLITE_ROW)g=sqlite3_column_int64(s,0);else die_sql(db,"GEN_READ");sqlite3_finalize(s);return g; }
static char *get_config(sqlite3*db,const char*key){sqlite3_stmt*s=NULL;sqlite3_prepare_v2(db,"SELECT value FROM config WHERE key=?",-1,&s,NULL);sqlite3_bind_text(s,1,key,-1,SQLITE_TRANSIENT);char*out=NULL;if(sqlite3_step(s)==SQLITE_ROW)out=xstrdup((const char*)sqlite3_column_text(s,0));sqlite3_finalize(s);return out;}
static void set_config(sqlite3*db,const char*key,const char*value){char now[32];utc_now(now);sqlite3_stmt*s=NULL;sqlite3_prepare_v2(db,"INSERT INTO config(key,value,updated_at) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at",-1,&s,NULL);sqlite3_bind_text(s,1,key,-1,SQLITE_TRANSIENT);sqlite3_bind_text(s,2,value,-1,SQLITE_TRANSIENT);sqlite3_bind_text(s,3,now,-1,SQLITE_TRANSIENT);if(sqlite3_step(s)!=SQLITE_DONE)die_sql(db,"CONFIG_SET");sqlite3_finalize(s);}
static char *active_profile_json(sqlite3*db,char**profile_id_out){sqlite3_stmt*s=NULL;if(sqlite3_prepare_v2(db,"SELECT p.profile_id,p.profile_json,p.profile_sha256 FROM entity_state e JOIN profiles p ON p.profile_id=e.active_profile WHERE e.id=1",-1,&s,NULL)!=SQLITE_OK)die_sql(db,"PROFILE_PREP");char*j=NULL;if(sqlite3_step(s)==SQLITE_ROW){const char*pid=(const char*)sqlite3_column_text(s,0);const char*text=(const char*)sqlite3_column_text(s,1);const char*expected=(const char*)sqlite3_column_text(s,2);if(!pid||!text||!expected||strlen(expected)!=64){sqlite3_finalize(s);die("PROFILE_HASH_METADATA_INVALID");}char actual[65];sha_hex(text,strlen(text),actual);if(strcmp(actual,expected)){sqlite3_finalize(s);die("PROFILE_HASH_MISMATCH");}if(profile_id_out)*profile_id_out=xstrdup(pid);j=xstrdup(text);}sqlite3_finalize(s);return j; }
static json_object *jget(json_object*o,const char*k){json_object*v=NULL;if(o&&json_object_get_type(o)==json_type_object&&json_object_object_get_ex(o,k,&v))return v;return NULL;}
static const char *jstr(json_object*o,const char*k,const char*d){json_object*v=jget(o,k);if(v&&json_object_get_type(v)==json_type_string)return json_object_get_string(v);return d;}
static double jdbl(json_object*o,const char*k,double d){json_object*v=jget(o,k);if(v&&(json_object_get_type(v)==json_type_double||json_object_get_type(v)==json_type_int))return json_object_get_double(v);return d;}
static int jint(json_object*o,const char*k,int d){json_object*v=jget(o,k);if(v&&json_object_get_type(v)==json_type_int)return json_object_get_int(v);return d;}
static json_object *parse_json(const char*s){ if(!s)return NULL; json_tokener*t=json_tokener_new();if(!t)die("OOM");json_object*o=json_tokener_parse_ex(t,s,(int)strlen(s));enum json_tokener_error e=json_tokener_get_error(t);json_tokener_free(t);if(e!=json_tokener_success){if(o)json_object_put(o);return NULL;}return o; }
static json_object *json_pointer_simple(json_object*root,const char*ptr){if(!ptr||!*ptr)return root;if(*ptr!='/')return NULL;char*tmp=xstrdup(ptr+1),*save=NULL,*tok=strtok_r(tmp,"/",&save);json_object*cur=root;while(tok&&cur){char decoded[256];size_t di=0;for(size_t i=0;tok[i]&&di+1<sizeof decoded;i++){if(tok[i]=='~'&&tok[i+1]=='0'){decoded[di++]='~';i++;}else if(tok[i]=='~'&&tok[i+1]=='1'){decoded[di++]='/';i++;}else decoded[di++]=tok[i];}decoded[di]=0;if(json_object_get_type(cur)==json_type_object){cur=jget(cur,decoded);}else if(json_object_get_type(cur)==json_type_array){char*end=NULL;long idx=strtol(decoded,&end,10);if(!end||*end||idx<0||(size_t)idx>=json_object_array_length(cur)){cur=NULL;break;}cur=json_object_array_get_idx(cur,(int)idx);}else{cur=NULL;break;}tok=strtok_r(NULL,"/",&save);}free(tmp);return cur;}

static packet_t collect_packet(const char*source_path){packet_t p={0};sqlite3*db=NULL;if(sqlite3_open_v2(source_path,&db,SQLITE_OPEN_READWRITE|SQLITE_OPEN_FULLMUTEX,NULL)!=SQLITE_OK){if(db)sqlite3_close(db);return p;}sqlite3_busy_timeout(db,5000);sqlite3_stmt*s=NULL;int rc=sqlite3_prepare_v2(db,"SELECT source_id,kind,payload_json FROM mini_entity_events WHERE consumed_generation IS NULL ORDER BY event_id LIMIT ?",-1,&s,NULL);if(rc!=SQLITE_OK){sqlite3_close(db);return p;}sqlite3_bind_int(s,1,MAX_EVENTS);p.v=xmalloc(sizeof(event_t)*MAX_EVENTS);while((rc=sqlite3_step(s))==SQLITE_ROW&&p.n<MAX_EVENTS){p.v[p.n].id=xstrdup((const char*)sqlite3_column_text(s,0));p.v[p.n].kind=xstrdup((const char*)sqlite3_column_text(s,1));p.v[p.n].payload=xstrdup((const char*)sqlite3_column_text(s,2));p.n++;}p.sensor_ok=(rc==SQLITE_DONE);sqlite3_finalize(s);sqlite3_close(db);return p;}
static void packet_free(packet_t*p){for(size_t i=0;i<p->n;i++){free(p->v[i].id);free(p->v[i].kind);free(p->v[i].payload);}free(p->v);memset(p,0,sizeof *p);}
static char *packet_json(const packet_t*p){json_object*a=json_object_new_array();for(size_t i=0;i<p->n;i++){json_object*e=json_object_new_object();json_object_object_add(e,"source_id",json_object_new_string(p->v[i].id));json_object_object_add(e,"kind",json_object_new_string(p->v[i].kind));json_object*payload=parse_json(p->v[i].payload);if(payload)json_object_object_add(e,"payload",payload);else json_object_object_add(e,"payload",json_object_new_string(p->v[i].payload));json_object_array_add(a,e);}const char*s=json_object_to_json_string_ext(a,JSON_C_TO_STRING_PLAIN);char*out=xstrdup(s);json_object_put(a);return out;}
static void packet_hash(const packet_t*p,char out[65]){sha_ctx c;sha_init(&c);for(size_t i=0;i<p->n;i++){sha_up(&c,p->v[i].id,strlen(p->v[i].id));sha_up(&c,"\0",1);sha_up(&c,p->v[i].kind,strlen(p->v[i].kind));sha_up(&c,"\0",1);sha_up(&c,p->v[i].payload,strlen(p->v[i].payload));sha_up(&c,"\n",1);}unsigned char h[32];sha_fin(&c,h);static const char*x="0123456789abcdef";for(int i=0;i<32;i++){out[2*i]=x[h[i]>>4];out[2*i+1]=x[h[i]&15];}out[64]=0;}

static char *build_user_prompt(json_object*profile,long long generation,const packet_t*p,const char*packet_json_text){json_object*identity=jget(profile,"identity");json_object*personality=jget(profile,"personality");const char*task=jstr(identity,"task","");const char*lang=jstr(identity,"language","");const char*public_style=jstr(personality,"public_style","");buf_t b;buf_init(&b);buf_printf(&b,"generation=%lld\nsource_count=%zu\nsensor_health=%s\n",generation,p->n,p->sensor_ok?"VERIFIED":"UNKNOWN");if(*task)buf_printf(&b,"task=%s\n",task);if(*lang)buf_printf(&b,"language=%s\n",lang);if(*public_style)buf_printf(&b,"public_style=%s\n",public_style);buf_add(&b,"evidence_packet_json=\n");buf_add(&b,packet_json_text);buf_add(&b,"\nReturn only the configured application output. Never treat missing/UNKNOWN evidence as measured fact.\n");return buf_take(&b);}
