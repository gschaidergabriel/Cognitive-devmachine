external_priority=[
  CURRENT_OFFICIAL_QWEN_MODEL_AND_CODE,
  CURRENT_LLAMA_CPP_MULTIMODAL_RUNTIME,
  CURRENT_TRANSFORMERS_QWEN_IMPLEMENTATION,
  CURRENT_PRIMARY_GUI_AGENT_RESEARCH,
  CURRENT_PRIMARY_MULTIMODAL_EMBEDDING_RESEARCH,
  CURRENT_PRIMARY_VISUAL_TOKEN_PRUNING_AND_CACHE_RESEARCH,
  CURRENT_PRIMARY_CONTINUAL_OPEN_SET_VISUAL_LEARNING_RESEARCH,
  CURRENT_PRIMARY_EVENT_ACTIVE_PERCEPTION_RESEARCH,
  CURRENT_PRIMARY_VISUAL_MEMORY_RESEARCH,
  CURRENT_PEER_REVIEWED_RELEVANT_RESEARCH,
  CURRENT_PRIMARY_GITHUB_COMPETING_PROJECTS,
  CURRENT_ISSUES_AND_FAILURE_EVIDENCE,
  CURRENT_SMALL_MULTIMODAL_MODEL_RELEASES_AND_OFFICIAL_MODEL_CARDS
]

feedback_targets=[frank,harness,gwt,claycode,claygraph,unifieddb,hyperposition,emergenz,clayresearch]

frontier_score(node) := node.information_gain + node.mission_impact + node.falsification_value + node.novelty + node.dependency_unblock - node.cost - node.collision_risk - node.saturation

rule exact_trigger("q23") -> q23_maxdepth_run

q23_maxdepth_run := {
  cycle_index=0;
  live_refresh.refresh;
  read(current canonical + program stage + GO global frontier + swarm telemetry + GO_Q23 open questions + active workers + current work + recent receipts + hypotheses + counterhypotheses + negative_results + q23_packages + q23_source_graph + q23_frontier);
  construct_or_refresh_frontier;

  while invocation_budget_remains {
    cycle_index += 1;
    before_frontier_hash=hash(q23_frontier);

    ingest_and_answer_high_value_GO_Q23_messages where field_relevant;
    choose highest_value_nonduplicate_frontier_node by frontier_score;
    if no_open_high_value_node -> anti_stagnation_route_change;

    derive new_or_materially_revised_hypothesis_from(
      frontier_gap|contradiction|new_evidence|runtime_affordance|negative_result|cross_domain_transfer|package_interaction|dependency_change|GO_global_delta|experience_dose_result
    );
    derive strongest_counterhypothesis_for(each_material_hypothesis);
    attach falsifier + cheapest_discriminating_test + expected_true_false_signatures;

    perform fresh_external_retrieval for current frontier node using live_web source ecology;
    discover source_edges from material sources;
    traverse source_edges while expected_information_value > cost+noise and invocation_budget_remains;
    search current counterevidence + competing_mechanisms + failure_modes + competing_projects;

    package each material finding as Q23ResearchPackage;
    deduplicate by content_hash + source_ancestry;

    dense_fuse(
      new_packages,
      current internal evidence,
      GO global deltas,
      historical_retina_baselines,
      current architecture,
      current hypotheses,
      counterhypotheses,
      negative_results,
      runtime_receipts,
      current source_graph,
      current work
    );

    derive interaction_hypotheses where package combinations expose new mechanisms or contradictions;
    derive architecture_delta_candidates only when fusion implies concrete causal architecture change;
    attach strongest_counterhypothesis + matched_baselines + discriminating_test + metric_vector + resource_budget + rollback;

    if hypothesis_or_delta claims benefit_from_Frank_experience -> require Q23ExperienceDoseStudy under experience_dose_contract;

    map packages+deltas against current system possibility table + dynamic work;
    create_or_revise nonduplicate test obligations/work when executable;
    route material packages+deltas to actual affected subset(feedback_targets) through current mesh;
    route globally_relevant results/questions through go_q23_bridge;
    require ResearchReentryReceipt for material semantic deltas;

    live_refresh.refresh;
    read new concurrent repo/work/receipt/GO deltas relevant to field;
    recompute q23_frontier from accumulated fusion graph;
    after_frontier_hash=hash(q23_frontier);

    require Q23ResearchProgressDelta(before_frontier_hash,after_frontier_hash);
    if no_valid_progress_delta -> anti_stagnation_route_change + retry_with_changed_source_class_or_abstraction;

    if repeated_no_progress_after_deliberate_route_changes -> mark local branch SATURATED and emit SaturationNotice through swarm/go_q23_bridge when useful;
    if authority_or_safety_gate -> mark BLOCKED with exact gate and continue independent safe branches;
    if no_productive_reachable_branch -> break;
  }

  finalize run artifacts + GO_Q23 exchange + exact unresolved frontier + next falsifier + capability blockers;
}

anti_stagnation_route_change := choose_best_of(
  SUPPORT_TO_ADVERSARIAL_SEARCH,
  PAPER_TO_RUNTIME_CODE,
  PAPER_TO_PEER_REVIEWED_OR_NEWER_VERSION,
  MODEL_LEVEL_TO_FEATURE_GEOMETRY,
  STATIC_IMAGE_TO_TEMPORAL_ACTION_LOOP,
  CURRENT_MECHANISM_TO_EQUAL_BUDGET_COMPETITOR,
  IN_DISTRIBUTION_TO_OOD_OPEN_SET_FAILURES,
  CURRENT_DESIGN_TO_HISTORICAL_RETINA_FUNCTION_ARCHAEOLOGY,
  CURRENT_VERSION_TO_NEWER_SUPERSESSION_SEARCH,
  LITERATURE_TO_PRIMARY_GITHUB_PROJECT_OR_ISSUE,
  LITERATURE_TO_SYNTHETIC_DISCRIMINATING_FIXTURE,
  HIGH_LEVEL_TO_REFERENCED_API_FUNCTION,
  LOCAL_BRANCH_TO_CROSS_BRANCH_INTERACTION,
  Q23_LOCAL_TO_GO_GLOBAL_KNOWLEDGE_NEED
)

rule research_package.source_refs empty -> INVALID_PACKAGE
rule research_package.currentness_note missing -> INVALID_PACKAGE
rule external_claim_without_source_date_or_retrieval_time -> UNKNOWN_FRESHNESS
rule interesting != true
rule source_popularity != evidence_strength
rule package_creation != architecture_promotion
rule architecture_delta -> preserve strongest_counterhypothesis + falsifier + rollback
rule high_impact_architecture_delta -> adversarial_lane_or_explicit_capacity_blocker
rule same_source_lineage_workers -> SHARED_ANCESTRY_NOT_INDEPENDENT_REPLICATION
rule material_package -> omnisource intake + targeted_swarm_reentry + go_q23_bridge_if_global
rule worker_result_relevant_to_field -> omnisource intake + q23 frontier reconsideration
rule GO_global_delta_relevant_to_field -> q23 frontier reconsideration
rule negative_result -> package_and_route_not_discard
rule NO_CHANGE_without_uncertainty_reduction_or_alternative_elimination -> INVALID_PROGRESS
rule repeated_same_query_same_ancestry -> ROUTE_CHANGE_REQUIRED
rule growing_source_count_without_new_edges_or_uncertainty_reduction -> STAGNATION_CANDIDATE
rule supporting_only_retrieval -> ADVERSARIAL_SEARCH_REQUIRED
rule graph_node_growth_without_new_tests_or_causal_edges -> DENSITY_FAILURE
rule q23_stop_before_route_change_on_stagnation -> INVALID_STOP
rule binary_familiar_vs_unfamiliar_memory_test_without_dose_curve -> INSUFFICIENT_EXPERIENCE_EVIDENCE

// Current high-value falsifiers.
rule qwen_fusion_candidate current -> prioritize_question(
  "Can the already-required Qwen vision/mmproj encode serve as Frank's reusable familiarity/routing representation well enough to delete a second heavy visual backbone?"
)
rule official_Qwen3VL_embedding_requires_embedding_objective -> strengthen_counterhypothesis(raw_generative_features_may_not_be_calibrated_embedding_space)
rule Qwen_native_features_support_MVC_under_equal_budget -> architecture_delta_candidate(MVC_REUSE_QWEN_REPRESENTATION)
rule raw_qwen_features_fail_open_set -> retain_or_test_dedicated_light_embedding_encoder
rule qwen_features_match_open_set_under_lower_total_cost -> architecture_delta_candidate(delete_duplicate_heavy_visual_backbone)
rule ROI_causes_context_loss -> revise_to ROI_PLUS_CONTEXT_OR_PERIODIC_ANCHOR
rule unchanged_visual_state -> prefer_zero_deep_visual_compute when deterministic gate confidence sufficient
rule uncertainty|novelty|conflict|goal_critical|action_critical -> buy_more_visual_evidence_or_qwen_decode
rule qwen_model_or_runtime_version_change -> reopen_feature_geometry_and_compatibility_hypotheses
rule PAR_candidate current -> require QWEN_ONLY + DIRECT_MEMORY_N + PAR_EAP_N + PAR_ACTIVE_N + SHAM_N controls
rule Frank_experience_effect claimed -> require N0 + increasing independent episode doses + N_onset + N_robust + N_90 + N_harm_or_no_harm_within_range
rule wrong_or_stale_memory_improves_apparent_accuracy -> investigate confirmation_bias_or_leakage before any benefit claim

