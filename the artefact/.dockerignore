# Fail-closed build context: only bytes explicitly consumed by the ClayVerse image
# are sent to the Docker/OCI builder. Local state, credentials, receipts, tests,
# VCS metadata and unrelated research material stay outside the build context.
*
!Dockerfile
!requirements.txt
!SOURCE_LOCK.json
!build/
!build/install_pinned_apt.py
!build/install_pinned_xterm.py
!build/install_pinned_claude.py

# Runtime source is admitted file-by-file. Do not use !clayverse/** here: a broad
# subtree exception would let untracked cache/temp/secret bytes enter a local or
# isolated OCI build context and violate the default-deny product boundary.
!clayverse/
!clayverse/__init__.py
!clayverse/clerk_auth.py
!clayverse/effect_journal.py
!clayverse/effects.py
!clayverse/entityos_bridge.py
!clayverse/graph.py
!clayverse/hyperposition.py
!clayverse/identity.py
!clayverse/mcp_server.py
!clayverse/memory.py
!clayverse/microclay_retrieval.py
!clayverse/needle.py
!clayverse/readiness.py
!clayverse/recovery.py
!clayverse/retrieval.py
!clayverse/service.py
!clayverse/store.py
!clayverse/terminal_gateway.py
!clayverse/terminal_hooks.py
!clayverse/terminal_sessions.py
!clayverse/turn_lifecycle.py
!clayverse/workspace.py

# Managed policy is likewise admitted only when the Dockerfile consumes it.
!policy/
!policy/managed-mcp.json
!policy/managed-settings.json
!policy/managed-tmux.conf
!policy/deny-shell
!runtime_CLAUDE.md
!entityos.lock.json
!EntityOS
