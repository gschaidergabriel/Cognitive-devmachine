    if(!strcmp(op,"eq")){json_object*a=native_expr(jget(expr,"a"),ctx),*b=native_expr(jget(expr,"b"),ctx);int x=(!a&&!b)||(a&&b&&json_object_equal(a,b));if(a)json_object_put(a);if(b)json_object_put(b);return json_object_new_boolean(x);}
    if(!strcmp(op,"add")){json_object*a=jget(expr,"args");double sum=0.0;if(a&&json_object_get_type(a)==json_type_array){for(size_t i=0;i<json_object_array_length(a);i++){json_object*v=native_expr(json_object_array_get_idx(a,(int)i),ctx);sum+=native_num(v);if(v)json_object_put(v);}}return json_object_new_double(sum);}
