{
  "schema_version": "3.3",
  "matching": "trimmed_full_message_case_insensitive_exact",
  "authoritative_trigger_registry": "research_entity/global/RESEARCH_TRIGGER_REGISTRY.json",
  "status_footer_protocol": "research_entity/global/STATUS_FOOTER_PROTOCOL.md",
  "status_footer_checker": "tools/status_footer_check.py",
  "research_tool_orchestration_policy": "research_entity/global/RESEARCH_TOOL_ORCHESTRATION_POLICY.md",
  "research_tool_router": "tools/research_provider_router.py",
  "interconnection_protocol": "research_entity/global/INTERCONNECTED_RESEARCH_MESH_PROTOCOL.md",
  "interconnection_preflight": "tools/research_interconnect_preflight.py",
  "frank_clay_native_contract": "research_entity/global/FRANK_CLAY_NATIVE_CONTRACT.md",
  "frank_clay_native_contract_status": "PROJECT_OWNER_FIXED_TARGET_NOT_HYPOTHESIS",
  "frank_sole_intentional_non_clay_semantic_subsystem": "Needle",
  "clay_safe_effect_geometry_research_foundation": "research_entity/global/CLAY_SAFE_EFFECT_GEOMETRY_RESEARCH_FOUNDATION.md",
  "clay_safe_effect_geometry_status": "PROJECT_OWNER_MANDATED_PERMANENT_RESEARCH_AXIS_HYPOTHESES_REMAIN_FALSIFIABLE",
  "goodman_anti_echo_protocol": "research_entity/global/GOODMAN_ANTI_ECHO_PROTOCOL.md",
  "goodman_filter_checker": "tools/goodman_filter_check.py",
  "frank_architecture_contract": "tools/frank_architecture_contract.py",
  "fusion_research_contract": "tools/fusion_research_contract.py",
  "commands": {
    "dump": {
      "protocol": "research_entity/global/DUMP_PROTOCOL.md",
      "tool_orchestration_addendum": "research_entity/global/DUMP_TOOL_ORCHESTRATION_ADDENDUM.md",
      "kind": "research_intake",
      "requires_independent_support_for_promotion": true,
      "requires_tool_execution_manifest": true,
      "mesh_role": "intake_to_shared_mesh"
    },
    "fusion": {
      "protocol": "research_entity/triggers/FUSION_RESEARCH_PROTOCOL.md",
      "kind": "global_mesh_meta_research",
      "requires_interconnect_manifest": true,
      "requires_global_coverage_manifest": true,
      "requires_branch_feedback_manifest": true,
      "feedback_targets": ["clay", "frank", "gwt", "emergenz", "claycode", "hyperposition", "claygraph", "unifieddb"],
      "completion_validator": "tools/fusion_research_contract.py",
      "completion_command": "python tools/fusion_research_contract.py research_entity/trigger_runs/fusion/<run_id>"
    },
    "hypofusion": {
      "protocol": "research_entity/triggers/HYPOFUSION_RESEARCH_PROTOCOL.md",
      "kind": "hypothesis_screening_global_meta_research",
      "requires_interconnect_manifest": true,
      "requires_global_hypothesis_coverage": true,
      "requires_counterhypothesis_search": true,
      "requires_external_source_class_diversity": true,
      "requires_live_worker_reread": true,
      "requires_branch_feedback_manifest": true,
      "feedback_targets": ["clay", "frank", "gwt", "emergenz", "claycode", "hyperposition", "claygraph", "unifieddb"],
      "required_outputs": ["INTERCONNECT_MANIFEST.json", "HYPOTHESIS_COVERAGE_MATRIX.json", "EXTERNAL_EVIDENCE_LEDGER.md", "COUNTERHYPOTHESIS_MATRIX.json", "FUSION2_HYPOTHESES.json", "CONTRADICTION_MAP.md", "BRANCH_FEEDBACK_MANIFEST.json", "RUN_MANIFEST.json", "FINAL_REPORT.md"]
    },
    "clay": {
      "protocol": "research_entity/triggers/CLAY_RESEARCH_PROTOCOL.md",
      "kind": "integrated_research_foundry",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true,
      "permanent_research_foundations": ["research_entity/global/CLAY_SAFE_EFFECT_GEOMETRY_RESEARCH_FOUNDATION.md"],
      "requires_safe_effect_geometry_research": true,
      "required_safe_effect_artifact": "SAFE_EFFECT_GEOMETRY_DELTA.md",
      "safe_effect_research_rule": "The Safe-Effect/NDSAS research axis is mandatory and persistent, but its alignment/safety hypotheses remain falsifiable and may not be promoted without evidence."
    },
    "gwt": {
      "protocol": "research_entity/triggers/GWT_RESEARCH_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true
    },
    "frank": {
      "protocol": "research_entity/triggers/FRANK_RESEARCH_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "fixed_target_contract": "research_entity/global/FRANK_CLAY_NATIVE_CONTRACT.md",
      "clay_native_target_is_open_hypothesis": false,
      "sole_intentional_non_clay_semantic_subsystem": "Needle",
      "primary_foundation": "clay",
      "primary_architecture_language": "ClayCode semantic IR",
      "deep_secondary_foundation": "claycode",
      "deep_substrate_foundation": "claygraph",
      "deep_persistence_foundation": "unifieddb",
      "required_architecture_artifact": "FRANK_ARCHITECTURE.claycode.json",
      "required_human_mapping": "CLAYCODE_ARCHITECTURE_MAPPING.md",
      "architecture_validator": "tools/frank_architecture_contract.py"
    },
    "emergenz": {
      "protocol": "research_entity/triggers/EMERGENCE_RESEARCH_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true
    },
    "claycode": {
      "protocol": "research_entity/triggers/CLAYCODE_RESEARCH_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true,
      "primary_feedback_foundation": "frank",
      "requires_latest_frank_architecture_if_available": true,
      "requires_goodman_anti_echo_review": true,
      "required_goodman_artifact": "FRANK_CLAYCODE_GOODMAN_REVIEW.json",
      "goodman_validator": "tools/goodman_filter_check.py",
      "goodman_completion_mode": "validate-run",
      "completion_command": "python tools/goodman_filter_check.py validate-run research_entity/trigger_runs/claycode/<run_id>"
    },
    "hyperposition": {
      "protocol": "research_entity/triggers/HYPERPOSITION_RESEARCH_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true
    },
    "claygraph": {
      "protocol": "research_entity/triggers/CLAYGRAPH_RESEARCH_PROTOCOL.md",
      "foundation": "research_entity/global/CLAYGRAPH_RESEARCH_FOUNDATION.md",
      "evolution_protocol": "research_entity/claygraph/CLAYGRAPH_EVOLUTION_PROTOCOL.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true,
      "coverage_mode": "ALL_DISCOVERED_INDEXED_DOMAIN_FOCUSED",
      "primary_feedback_target": "frank",
      "requires_database_inventory": true,
      "requires_claycode_graph_schema": true,
      "requires_reversible_migration_plan": true,
      "requires_frank_feedback": true,
      "requires_self_use_benchmark": true,
      "accepted_graph": "research_entity/claygraph/CLAYGRAPH_LATEST.claycode.json",
      "required_outputs": ["DATABASE_INVENTORY.json", "CLAYGRAPH_SCHEMA.claycode.json", "SELF_USE_BENCHMARK.json", "MIGRATION_PLAN.json", "FRANK_CLAYGRAPH_FEEDBACK.json", "FINAL_REPORT.md"]
    },
    "unifieddb": {
      "protocol": "research_entity/triggers/UNIFIED_DATABASE_RESEARCH_PROTOCOL.md",
      "foundation": "research_entity/global/UNIFIED_DATABASE_RESEARCH_FOUNDATION.md",
      "kind": "domain_research",
      "requires_interconnect_manifest": true,
      "must_treat_frank_clay_native_contract_as_fixed": true,
      "coverage_mode": "ALL_DISCOVERED_INDEXED_DOMAIN_FOCUSED",
      "primary_feedback_targets": ["frank", "claycode", "claygraph"],
      "requires_store_role_matrix": true,
      "requires_logical_vs_physical_unification_analysis": true,
      "requires_reversible_migration_plan": true,
      "requires_query_routing_plan": true,
      "requires_selection_integrity_analysis": true,
      "required_outputs": ["STORE_ROLE_MATRIX.json", "UNIFIED_DATABASE_ARCHITECTURE.claycode.json", "QUERY_ROUTING_PLAN.json", "EXPERIMENT_RESULTS.json", "MIGRATION_PLAN.json", "BRANCH_FEEDBACK_MANIFEST.json", "FRANK_UNIFIEDDB_FEEDBACK.json", "FINAL_REPORT.md"]
    }
  },
  "rule": "Reserved commands fire only on exact full-message match. Every scientific research trigger loads the interconnected research mesh including fresh in-progress material and materializes INTERCONNECT_MANIFEST.json before Fusion 1, then executes the quota/health-aware research-tool plan or explicit covering fallbacks. All eight scientific branches treat the FRANK Clay-native contract as a project-owner fixed target rather than a yes/no hypothesis. Clay additionally carries Safe-Effect Geometry/NDSAS as a project-owner-mandated permanent research axis; every substantive Clay run must return a Safe-Effect delta or explicit NO_CHANGE while preserving the hypotheses as falsifiable. The fusion meta-trigger covers the complete current research graph/evidence classes and writes explicit feedback or NO_CHANGE receipts to all eight scientific branches. The hypofusion meta-trigger screens the complete reachable current/open hypothesis set against broad external evidence and deliberate counterhypotheses, rereads live workers before final fusion, and returns discriminating tests plus feedback to all eight branches. FRANK treats newest Clay research as primary architecture foundation, deeply ingests ClayCode, ClayGraph and UnifiedDB, and authors FRANK_ARCHITECTURE.claycode.json. ClayCode treats newest FRANK research/architecture as primary target feedback and applies the Goodman anti-echo filter. ClayGraph specializes in associative memory/graph evolution; UnifiedDB specializes in the broader unified persistence/query/transaction substrate and must never equate semantic unification with mandatory physical merge. Every substantive visible response ends with the required status footer including all registered short commands."
}
