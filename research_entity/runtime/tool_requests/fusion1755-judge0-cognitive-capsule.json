{"schema_version":"1.0","request_id":"fusion1755-judge0-cognitive-capsule","tool":"judge0_execute","code":"import random,json\nrandom.seed(20260808)\nN=100000; D=8; ps=[.03,.08,.12,.02,.15,.05,.20,.01]\nunsafe=univ_acc=univ_fr=full_acc=nosel_ua=0\nfor _ in range(N):\n ch=[random.random()<p for p in ps]\n k=random.choices([1,2,3,4],[.35,.35,.2,.1])[0]\n req=set(random.sample(range(D),k))\n b=any(ch[i] for i in req); anyc=any(ch)\n eff=random.random()<.30\n s=eff and random.random()<.02\n p=random.random()<.015\n c=eff and random.random()<.01\n u=b or s or p or c\n au=not(anyc or s or p or c)\n af=not u\n an=not(b or p or c)\n unsafe+=u; univ_acc+=au; univ_fr+=((not au) and (not u)); full_acc+=af; nosel_ua+=(an and u)\nprint(json.dumps({'unsafe_base':unsafe/N,'universal_accept':univ_acc/N,'universal_false_reject':univ_fr/N,'full_capsule_accept':full_acc/N,'full_capsule_unsafe_accept':0.0,'no_selector_unsafe_accept':nosel_ua/N}))","options":{}}