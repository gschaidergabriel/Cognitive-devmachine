#!/usr/bin/env python3
"""
clay-browser-tab-status — show all session -> tab assignments in the shared
gstack `browse` daemon, plus which live tabs are unowned and which registry
entries are orphaned (tab closed but never released; auto-cleaned here).

Usage:
  clay-browser-tab-status
"""
import sys
import os

sys.path.insert(0, os.path.expanduser("~/.claude/browser_lock"))
import tablib  # noqa: E402


def main():
    with tablib.Guard():
        live_ids = tablib.list_tab_ids()
        reg = tablib.load_registry()
        reg, removed = tablib.prune_orphans(reg, live_ids)
        tablib.save_registry(reg)

    if not live_ids and not reg and not removed:
        print("no tabs open, registry empty")
        return

    print(f"live tabs: {sorted(live_ids) if live_ids else '(none)'}")
    print()

    if reg:
        print("session -> tab assignments:")
        owned_ids = set()
        for sid, entry in sorted(reg.items(), key=lambda kv: kv[1].get("tab_id", 0)):
            owned_ids.add(entry.get("tab_id"))
            print(
                f"  session '{sid}' -> tab {entry.get('tab_id')} "
                f"(purpose: '{entry.get('purpose')}', since {entry.get('assigned_at')})"
            )
    else:
        print("session -> tab assignments: (none)")
        owned_ids = set()

    unowned = live_ids - owned_ids
    if unowned:
        print()
        print(f"unowned live tabs (not tracked by any session): {sorted(unowned)}")

    if removed:
        print()
        print("cleaned up orphaned registry entries (tab no longer exists):")
        for sid, entry in removed.items():
            print(f"  session '{sid}' -> tab {entry.get('tab_id')} (purpose: '{entry.get('purpose')}')")


if __name__ == "__main__":
    main()
