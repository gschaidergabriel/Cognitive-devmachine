{"schema_version":"1.0","request_id":"fusion1855-judge0-language-layer-identifiability","tool":"judge0_execute","code":"import random,json,itertools\nrandom.seed(1855)\ndef run(native,cn,n=10000):\n d={}\n for I,C,N,R in itertools.product([0,1],repeat=4):\n  p=.42+.06*I+.16*C+native*N+.11*R+cn*C*N+.03*C*R\n  p=max(.02,min(.98,p)); s=0\n  for _ in range(n): s += random.random()<p\n  d[(I,C,N,R)]=s/n\n off=d[(0,0,0,0)]; on=d[(1,1,1,1)]\n nav=sum(v for k,v in d.items() if k[2]==1)/8-sum(v for k,v in d.items() if k[2]==0)/8\n c11=sum(v for k,v in d.items() if k[1]==1 and k[2]==1)/4\n c10=sum(v for k,v in d.items() if k[1]==1 and k[2]==0)/4\n c01=sum(v for k,v in d.items() if k[1]==0 and k[2]==1)/4\n c00=sum(v for k,v in d.items() if k[1]==0 and k[2]==0)/4\n return {'all_off':off,'all_on':on,'bundled_delta':on-off,'native_orthogonal_delta':nav,'canonical_x_native_interaction':(c11-c10)-(c01-c00)}\nprint(json.dumps({'native_null':run(0,0),'native_present':run(.07,.04)}))","options":{}}