module clay.call_contract
version "1.0-candidate"
status RESEARCH_CANDIDATE_NOT_PROMOTED

type CallEffectClass=PURE|READ_STATE|DERIVED_STATE|RESEARCH_ONLY|EXTERNAL_EFFECT
type CallResolutionState=UNRESOLVED_SIGNATURE|DECLARED_SIGNATURE_EXACT_NONEXECUTABLE_UNTIL_BINDING|EFFECT_BOUNDARY_SIGNATURE_MISSING|BOUND_CURRENT_RUNTIME
type CallBindingAuthority=NONE|RUNTIME_BROKER_ONLY

record CallParamContract {
  name:Symbol
  type_name:Symbol
}

record CallRuntimeBinding {
  binding_id:ResourceRef
  component_hash:Hash
  sealed:Bool
  authority_scope_ref:Ref?
  rollback_ref:Ref?
}

record CallContractIdentity {
  target:Symbol
  arity:Int
}

record CallContract {
  identity:CallContractIdentity
  params:Ordered<CallParamContract>
  returns:Symbol
  effect_class:CallEffectClass
  evidence_refs:Set<EvidenceRef>
  runtime_binding:CallRuntimeBinding?
  binding_authority:CallBindingAuthority
}

record CallContractObligation {
  identity:CallContractIdentity
  occurrences:Int
  resolution_state:CallResolutionState
  same_basename_candidates:Set<Symbol>
  type_name_resemblance:Symbol?
  effect_boundary:Bool
  sealed_runtime_binding_required:Bool
  execution_admitted:Bool
}

record CallExecutionPrecondition {
  contract_identity:CallContractIdentity
  contract_semantic_hash:Hash
  runtime_component_hash:Hash
  current_work_revision:Version
  effect_authority:CallBindingAuthority
}

invariant call_target_and_arity_are_exact_identity=true
invariant basename_or_suffix_match_is_signature=false
invariant type_name_resemblance_is_constructor_contract=false
invariant rule_text_is_executable_signature=false
invariant unresolved_call_executes=false
invariant contract_without_current_runtime_binding_executes=false
invariant external_effect_without_sealed_binding_executes=false
invariant call_contract_mints_truth_authority=false
invariant call_contract_mints_effect_authority=false
invariant runtime_broker_authority_is_separate_from_contract_semantics=true
