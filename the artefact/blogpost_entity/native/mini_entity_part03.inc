static int attach_source(sqlite3*db,const char*path){sqlite3_stmt*s=NULL;if(sqlite3_prepare_v2(db,"ATTACH DATABASE ? AS source",-1,&s,NULL)!=SQLITE_OK)return 0;sqlite3_bind_text(s,1,path,-1,SQLITE_TRANSIENT);int ok=sqlite3_step(s)==SQLITE_DONE;sqlite3_finalize(s);if(ok)sql_exec(db,"PRAGMA source.journal_mode=DELETE; PRAGMA source.synchronous=FULL;");return ok;}
