{
  "schema_version": "2.2",
  "purpose": "Registry of external research, verification and execution capabilities available to FRANK/RAE runtimes. Credential values live only in the designated private token store, never in this registry.",
  "secret_policy": {
    "canonical_private_store": "research_entity/private/API_TOKENS.env",
    "allowed_sources": [
      "process_environment",
      "runtime_secret_store",
      "private_repo_token_store"
    ],
    "source_priority": [
      "process_environment",
      "runtime_secret_store",
      "private_repo_token_store"
    ],
    "forbidden_duplication_targets": [
      "canonical_state",
      "research_packets",
      "claims",
      "run_reports",
      "logs",
      "public_artifacts",
      "chat_memory"
    ],
    "rule": "By explicit project-owner decision, credential values may be persisted in the designated store of this private repository when the active connector permits it. Load only the needed credential and never duplicate its value into research artifacts or logs."
  },
  "runtime_health": {
    "consolidated_state": "research_entity/runtime/PROVIDER_HEALTH.json",
    "audit_tool": "tools/provider_health_audit.py",
    "audit_workflow": ".github/workflows/provider-health-audit.yml",
    "rule": "Credential validity, provider runtime health and worker-surface invocability are distinct states. Never infer one from another."
  },
  "worker_invocation_bridge": {
    "status": "OPERATIONAL",
    "tool": "tools/research_tool_bridge.py",
    "workflow": ".github/workflows/research-tool-bridge.yml",
    "request_dir": "research_entity/runtime/tool_requests",
    "result_dir": "research_entity/runtime/tool_results",
    "purpose": "Allow GitHub-connected workers that cannot directly execute repository adapters to enqueue allowlisted provider requests; GitHub Actions executes them with private-repo credentials and writes sanitized results.",
    "security": "allowlisted adapters only; no credential output; remote code adapters are Python-only and execute at the remote sandbox/runtime, not in the GitHub runner; Hugging Face chat requires explicit allow_cost=true."
  },
