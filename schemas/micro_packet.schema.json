{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.local/schemas/micro_packet.schema.json",
  "title": "RAE Surgical Micro Packet",
  "type": "object",
  "required": ["packet_id", "topic", "statement", "epistemic_class", "status", "source_refs", "created_at"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 4},
    "topic": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["CLAIM", "MECHANISM", "RESULT", "CONSTRAINT", "METHOD", "NEGATIVE_RESULT", "HYPOTHESIS", "COUNTERHYPOTHESIS", "OBSERVATION", "ARCHITECTURE", "METRIC", "DEFINITION", "OTHER"]},
    "epistemic_class": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["CURRENT", "OPEN", "SUPERSEDED", "REFUTED", "NEGATIVE_RESULT", "CONTEXT_ONLY", "NOT_SELECTED"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "scope": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "origin_actor": {"type": ["string", "null"]},
    "origin_class": {"type": ["string", "null"]},
    "dump_batch_id": {"type": ["string", "null"]},
    "version_or_date": {"type": ["string", "null"]},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {"type": "string"},
          "target": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "falsifier": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
