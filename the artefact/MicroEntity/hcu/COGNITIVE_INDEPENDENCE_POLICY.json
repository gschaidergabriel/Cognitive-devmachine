    "engines": {
      "hcu_local_08b": {
        "class": "LOCAL_SHARED_WEIGHT_08B",
        "role": "SELECTIVE_HCU_MODEL_LANES",
        "runtime_identity": "REQUIRED",
        "checkpoint_identity": "REQUIRED",
        "tokenizer_identity": "REQUIRED",
        "artifact_sha256": "REQUIRED_LOWERCASE_SHA256",
        "network_required": false,
        "secret_lookup_required": false
      }
    },
    "event_self_asserted_engine_digest_without_registry_match": "REJECT",
    "unknown_provider_or_engine": "REJECT",
    "downstream_inference_receipt": "MUST_ECHO_CAUSAL_EVENT_ROUTE_AND_ENGINE_IDENTITIES"
  },
  "providers": {
    "nvidia": {
      "internal_cognitive_dependency": false,
      "embedding_dependency": false,
      "allowed_roles": ["RESEARCH_WORKER", "OPTIONAL_CANDIDATE_FEED", "DIRECT_TARGETED_FALLBACK"]
    },
    "mistral": {
      "internal_cognitive_dependency": false,
      "allowed_roles": ["RESEARCH_WORKER", "OPTIONAL_CANDIDATE_FEED", "DIRECT_TARGETED_FALLBACK"]
    },
    "groq": {
      "internal_cognitive_dependency": false,
      "allowed_roles": ["RESEARCH_WORKER", "OPTIONAL_CANDIDATE_FEED", "DIRECT_TARGETED_FALLBACK"]
    },
    "claude_code": {
      "internal_cognitive_dependency": false,
      "role": "PREFERRED_HIGH_CAPABILITY_TARGETED_CANDIDATE_INFERENCE",
      "direct_private_latent_access": "UNOBSERVED",
      "jspace_mode": "COMPILED_EXTERNAL_UNTIL_MEASURED_OTHERWISE"
    }
  },
  "boot_without_external_providers": "REQUIRED",
  "world_model_continuity_without_external_providers": "REQUIRED",
