  "stdout_tail": "ANCHORS_JSON\n{\n  \"quelle\": \"messen_augenanker_exakt.py -- exakte Reproduktion der Erzeugungs-Transform, kein Schaetzwert\",\n  \"head_anchor\": {\n    \"x\": 768,\n    \"y\": 600\n  },\n  \"augen_anker_roll0\": {\n    \"x\": 610,\n    \"y\": 207\n  },\n  \"werte\": {\n    \"-25\": {\n      \"dx_px\": -32.5,\n      \"dy_px\": 22.0\n    },\n    \"-20\": {\n      \"dx_px\": -30.0,\n      \"dy_px\": 12.0\n    },\n    \"-15\": {\n      \"dx_px\": -24.0,\n      \"dy_px\": 5.0\n    },\n    \"-10\": {\n      \"dx_px\": -16.5,\n      \"dy_px\": 0.0\n    },\n    \"-5\": {\n      \"dx_px\": -9.5,\n      \"dy_px\": -1.0\n    },\n    \"0\": {\n      \"dx_px\": 0.5,\n      \"dy_px\": 0.5\n    },\n    \"5\": {\n      \"dx_px\": 10.5,\n      \"dy_px\": -29.0\n    },\n    \"10\": {\n      \"dx_px\": 22.0,\n      \"dy_px\": -55.5\n    },\n    \"15\": {\n      \"dx_px\": 35.0,\n      \"dy_px\": -77.5\n    },\n    \"20\": {\n      \"dx_px\": 47.5,\n      \"dy_px\": -97.0\n    },\n    \"25\": {\n      \"dx_px\": 62.5,\n      \"dy_px\": -112.0\n    }\n  }\n}\nANCHOR_SCRIPT_HEAD\n#!/usr/bin/env python3\n\"\"\"messen_augenanker_exakt.py -- EXAKTE (nicht gemessene/geschaetzte) Position\ndes Augen-Ankers pro Rollwinkel, per Reproduktion derselben PIL-Transform, die\ndocs/build_rig_v2.py fuer die Kopf-Rollposen benutzt hat\n(transform_crop_about_anchor: rotate(angle=-roll, expand=True) um die\nBildmitte, dann bottom-center-Pin auf den Anker (768,600)).\n\nStatt die Bilder zu vergleichen (Template-Matching, ungenau bei starker\nVerzerrung), wird ein einzelner Marker-Punkt an der bekannten Augen-Anker-\nPosition durch EXAKT dieselbe Transformation geschickt wie das Kopfbild\nselbst -- das Ergebnis ist geometrisch exakt, kein Schaetzwert.\n\"\"\"\nimport json\nimport os\n\nfrom PIL import Image\n\nVISUAL = os.path.dirname(os.path.abspath(__file__))\nKOPF_MASTER = os.path.join(VISUAL, \"kopf\", \"master\", \"kopf_zero_mit_augen.png\")\nMANIFEST = os.path.join(VISUAL, \"manifest.json\")\nAUSGABE = os.path.join(VISUAL, \"augen_anker_exakt.json\")\n\nHEAD_ANCHOR = (768, 600)  # aus manifest.json head_neck_anchor\n\n\ndef transform_crop_about_anchor(canvas_1536x1024, head_bbox, angle=0.0, anchor=HEAD_ANCHOR):\n    \"\"\"1:1 Nachbau von build_rig_v2.py's transform_crop_about_anchor, aber mit\n    dem EXPLIZIT bekannten head_bbox statt Auto-Detektion -- fuer den echten\n    Kopf ist das identisch (dessen Alpha-bbox IST head_bbox), fuer den\n    Marker-Layer (fast leer bis auf einen Punkt) muss die Crop-Box explizit\n    vorgegeben werden, sonst croppt PIL auf den fast-leeren Inhalt statt auf\n    dieselbe Region wie beim echten Kopf.\"\"\"\n    crop = canvas_1536x1024.crop(head_bbox)\n    if angle:\n        crop = crop.rotate(angle, resample=Image.Resampling.BICUBIC, expand=True)\n    x = round(anchor[0] - crop.width / 2)\n    y = round(anchor[1] - crop.height)\n    out = Image.new(\"RGBA\", (1536, 1024), (0, 0, 0, 0))\n    out.alpha_composite(crop, (x, y))\n    return out\n\n\ndef main():\n    with open(MANIFEST, encoding=\"utf-8\") as f:\n        manifest = json.load(f)\n    eyes_glow_anchor = None\n    for a in manifest[\"assets\"]:\n        if a[\"path\"] == \"augen/gaze/rotglow_tracking_master.png\":\n            eyes_glow_anchor = (a[\"anchor\"][\"x\"], a[\"anchor\"][\"y\"])\n    if eyes_glow_anchor is None:\n        raise RuntimeError(\"augen/gaze/rotglow_tracking_master.png nicht im Manifest gefunden\")\n    print(\"Augen-Anker (roll=0, aus Manifest):\", eyes_glow_anchor)\n\n    head = Image.open(KOPF_MASTER).convert(\"RGBA\")\n    head_bbox = head.getchannel(\"A\").getbbox()\n    bx0, by0, bx1, by1 = head_bbox\n    print(\"Kopf-Crop-Box (roll=0):\", head_bbox, \"Groesse:\", (bx1 - bx0, by1 - by0))\n\n    # Marker: volle 1536x1024-Leinwand (wie das echte roll=0-Kopfbild), ein\n    # 5x5-Punkt an der ABSOLUTEN Augen-Anker-Position auf dieser Leinwand --\n    # exakt analog dazu, wie der echte Kopf-Layer auf derselben Leinwand liegt.\n    marker = Image.new(\"RGBA\", (1536, 1024), (0, 0, 0, 0))\n    for dx in range(-2, 3):\n        for dy in range(-2, 3):\n            xx, yy = eyes_glow_anchor[0] + dx, eyes_glow_anchor[1] + dy\n            marker.putpixel((xx, yy), (255, 0, 0, 255))\n\n    ergebnis = {}\n    for roll in range(-25, 26, 5):\n        out = transform_crop_about_anchor(marker, head_bbox, angle=-roll, anchor=HEAD_ANCHOR)\n        bbox_out = out.getchannel(\"A\").getbbox()\n        if bbox_out is None:\n            raise RuntimeError(f\"Marker bei roll={roll} verschwunden -- Transform-Fehler\")\n        cx = (bbox_out[0] + bbox_out[2]) / 2\n        cy = (bbox_out[1] + bbox_out[3]) / 2\n        dx = cx - eyes_glow_anchor[0]\n        dy = cy - eyes_glow_anchor[1]\n        ergebnis[str(roll)] = {\"dx_px\": round(dx, 2), \"dy_px\": round(dy, 2)}\n        print(f\"roll={roll:+3d}  dx={dx:+7.2f}px  dy={dy:+7.2f}px\")\n\n    with open(AUSGABE, \"w\", encoding=\"utf-8\") as f:\n        json.dump(\n            {\n                \"quelle\": \"messen_augenanker_exakt.py -- exakte Reproduktion der Erzeugungs-Transform, kein Schaetzwert\",\n                \"head_anchor\": {\"x\": HEAD_ANCHOR[0], \"y\": HEAD_ANCHOR[1]},\n                \"augen_anker_roll0\": {\"x\": eyes_glow_anchor[0], \"y\": eyes_glow_anchor[1]},\n                \"werte\": ergebnis,\n            },\n            f,\n            indent=2,\n            ensure_ascii=False,\n        )\n    print(\"\\ngespeichert:\", AUSGABE)\n\n\nif __name__ == \"__main__\":\n    main()\nHEAD_REFERENCES\n398:             <img id=\"kopf-schicht\" src=\"/kopf_rgba/kopf_zero_ohne_rotes_augenglow.png\" alt=\"\">\n399:             <!-- \u2b50 2026-09-11 echte Kopfdrehung: /kopf_rgba/roll/ hat 11 echte\n404:             <img id=\"kopf-schicht2\" src=\"/kopf_rgba/roll/gier_+00_nick_+00_roll_+00.png\" alt=\"\">\n416:                  (/kopf_rgba/roll/...+15/+25 etc.) wechselten, blieb der Augen-\n718: // Feder. /kopf_rgba/roll/ enthaelt 11 echte Posen (gier_+00_nick_+00_roll_+NN,\n731: function kopfRollDatei(w){\n732:   return `/kopf_rgba/roll/gier_+00_nick_+00_roll_${w < 0 ? \"-\" : \"+\"}${String(Math.abs(w)).padStart(2,\"0\")}.png`;\n744:     schritte.push({w, src: kopfRollDatei(w)});\n760:   // \u2b50\u2b50 PERF-FIX 2026-09-11: atmen() aktualisiert seit diesem Fix nur noch\n761:   // die aktuell sichtbare Kopf-Ebene (siehe atmen() oben) -- die Ebene, die\n762:   // hier gerade sichtbar wird, muss deshalb JETZT einmalig den brandaktuellen\n763:   // Atem-Wert bekommen, sonst zeigt sie beim ersten sichtbaren Frame noch den\n764:   // Wert von ihrem letzten Auftritt (Pop). _atmenTransform/_atmenFilter sind\n765:   // von atmen() diesen Frame schon gesetzt (schleife() ruft atmen() vor\n766:   // kopfRollTick() auf).\n767:   $(ein).style.transform = _atmenTransform;\n768:   $(ein).style.filter = _atmenFilter;\n769:   $(ein).style.opacity = \"1\";\n770:   $(aus).style.opacity = \"0\";\n771:   kopfRollAktiv = !kopfRollAktiv;\n772:   kopfRollWert = schritt.w;\n773:   kopfRollIdx++;\n774:   if(kopfRollIdx >= kopfRollSchritte.length){\n775:     const f = kopfRollFertigFn;\n776:     kopfRollSchritte = null; kopfRollFertigFn = null;\n777:     if(f) f();\n778:   }\n779: }\n780: let kDrehRot=0, kDrehRotV=0, kDrehTy=0, kDrehTyV=0;   // Kopf-Wrapper: Wert+Geschwindigkeit\n781: let bDrehRot=0, bDrehRotV=0, bDrehTy=0, bDrehTyV=0;   // Koerper-Wrapper: eigene, weichere Feder\n782: // \u2b50\u2b50 2026-09-11 NACHTRAG 4: der Augen-Flicken (#pupillen-glow/#augen-blink)\n783: // liegt jetzt IN #kopf-dreh und bekommt darueber automatisch schon kDrehRot\n784: // (die kleine, gedaempfte Feder, max \u00b13\u00b0) mit. Das reicht bei einer ECHTEN\n785: // Rollpose (bis \u00b125\u00b0, siehe KOPF_ROLL_POOL) nicht -- die Feder zielt bewusst\n786: // nur auf 12% des Rollwerts, weil das FOTO selbst schon kippt. Der Flicken\n787: // braucht den FEHLENDEN Rest (Rollwert minus das, was die Feder schon liefert)\n788: // als EIGENE Zusatzdrehung, um genau auf dem echten Fotowinkel zu landen --\n789: // gerechnet um denselben Halsanker (transform-origin oben, exakt umgerechnet).\n790: //\n791: // \u2b50\u2b50\u2b50 2026-09-11 STIRN-LUECKE GEFIXT (Animations-Agent, dritte Instanz\n792: // derselben Fehlerklasse wie Halsnaht/Geisterkopf -- Beleg: Screenshots\n793: // liveblick_10/11.png vom Koordinator, live reproduziert allein mit der\n794: // 'k'-Testtaste, siehe /tmp/t3_02_supermacro.png/t3_03_supermacro.png im\n795: // Bericht). ZWEI Fehler in der alten Formel `kopfRollWert - kDrehRot`:\n796: //   (1) FALSCHES VORZEICHEN/DOPPELABZUG: #kopf-dreh vererbt kDrehRot per CSS\n797: //       AUTOMATISCH an ALLE Kinder -- also auch an den Flicken UND ans\n798: //       Kopf-Foto gleichermassen. Die Gesamtdrehung des Fotos ist deshalb\n799: //       kopfRollWert(eingebrannt) + kDrehRot(Wrapper). Fuer denselben\n800: //       Gesamtwert beim Flicken (eigene Drehung + geerbtes kDrehRot vom\n801: //       selben Wrapper) muss die EIGENE Drehung exakt kopfRollWert sein --\n802: //       kDrehRot kuerzt sich rechnerisch von selbst weg, ihn nochmal\n803: //       abzuziehen zieht ihn ZWEIMAL ab. Ergebnis vorher: der Flicken lag\n804: //       bei JEDER Kopfneigung (auch der kleinen Idle-Feder, nicht nur bei\n805: //       einer echten Rollpose) um kDrehRot Grad (bis 3\u00b0) hinter dem echten\n806: //       Fotowinkel zurueck -- bei diesem weit aussenliegenden Drehpunkt\n807: //       (transform-origin ~2,4 Patch-Hoehen unterhalb der Box, siehe oben)\n808: //       schon das ein dauerhafter, wenn auch kleiner, Px-Versatz.\n809: //   (2) HARTER SPRUNG OHNE DAEMPFUNG: kopfRollWert selbst springt bei jedem\n810: //       kopfRollTick()-Schritt hart um 5\u00b0 (neues Foto -- das braucht keine\n811: //       Weichzeichnung, ein neues Foto sieht wie ein neues Foto aus). Der\n812: //       kleine, aber stark gehebelte Flicken macht aus genau diesem\n813: //       5\u00b0-Sprung einen sichtbaren Pop: bei ~2,4 Patch-Hoehen Hebelarm\n814: //       reisst ein 5\u00b0-Sprung den Flicken um zweistellige Px auf der\n815: //       Leinwand weg vom Gesicht -- fuer die ~110ms bis zum naechsten\n816: //       Schritt/bis die Feder aufholt genau die \"Stirn hochgeschobene\n817: //       Maske\"-Optik aus dem Befund. Fix: kopfRollAusgleichDeg ist jetzt\n818: //       eine geglaettete ANZEIGE (schneller Lerp, 0.4/Frame -- faengt sich\n819: //       in 2-3 Frames/<50ms, folgt dem echten Fotowinkel praktisch in\n820: //       Echtzeit, aber ohne den harten Ruck), die auf das jetzt korrekte\n821: //       Ziel (kopfRollWert, ohne Abzug) zulaeuft.\n822: let kopfRollAusgleichDeg = 0;\n823: // \u2b50\u2b50\u2b50 2026-09-12 VIERTE INSTANZ DERSELBEN FEHLERKLASSE, JETZT WIRKLICH\n824: // BEHOBEN (Koordinator-Befund + FRANK_AVATAR_RIG_V2/docs/build_rig_v2.py\n825: // gelesen statt weiter hand-gefittet): die drei vorherigen Fixes\n826: // (Halsnaht/Geisterkopf/Stirn-Luecke) korrigierten nur die ROTATION des\n827: // Augen-Flickens. Der eigentliche Rest-Fehler war eine fehlende\n828: // TRANSLATION: kopf/roll/*.png entstehen laut Erzeugungsskript per\n829: // transform_crop_about_anchor() -- Kopf wird um seine EIGENE Bildmitte\n830: // rotiert (PIL rotate(expand=True)), danach wird die neue, GROESSERE\n831: // Bounding-Box unten-mittig auf den festen Halsanker (768,600) gepinnt.\n832: // Das ist KEINE Rotation um einen festen externen Punkt (das waere ein\n833: // reines CSS rotate() um transform-origin) -- es ist \"rotiere um die\n834: // eigene Mitte, dann verschiebe die neue Box\". Ein Punkt, der (wie der\n835: // Augen-Anker bei 610,207) weit oben im Kopf-Crop sitzt, bewegt sich\n836: // dadurch NICHT auf einem Kreisbogen um (768,600), sondern auf einem\n837: // deutlich asymmetrischen Pfad. Exakt nachgerechnet (kein Schaetzwert --\n838: // derselbe Marker-Punkt durch dieselbe PIL-Transformation geschickt, siehe\n839: // rig2/messen_augenanker_exakt.py + rig2/augen_anker_exakt.json) statt\n840: // weiter an der Rotationsformel zu drehen.\n841: const KOPF_ROLL_AUGEN_OFFSET = { // native 1536x1024-Leinwand-Pixel, exakt\n842:   \"-25\": {dx:-32.5, dy: 22.0}, \"-20\": {dx:-30.0, dy: 12.0},\n843:   \"-15\": {dx:-24.0, dy:  5.0}, \"-10\": {dx:-16.5, dy:  0.0},\n844:   \"-5\":  {dx: -9.5, dy: -1.0}, \"0\":   {dx:  0.0, dy:  0.0},\n845:   \"5\":   {dx: 10.5, dy:-29.0}, \"10\":  {dx: 22.0, dy:-55.5},\n846:   \"15\":  {dx: 35.0, dy:-77.5}, \"20\":  {dx: 47.5, dy:-97.0},\n847:   \"25\":  {dx: 62.5, dy:-112.0},\n848: };\n849: let augenOffsetDx = 0, augenOffsetDy = 0; // geglaettete ANZEIGE, siehe kopfRollAusgleichDeg\n850: function federSchritt(ist, v, ziel, steife, daempfung){\n851:   v += (ziel - ist) * steife - v * daempfung;\n852:   ist += v;\n853:   return [ist, v];\n854: }\n855: function kopfKoerperDrehSchritt(){\n856:   // Federziel aus dem ECHTEN Rollwert (12% davon, auf \u00b13\u00b0 begrenzt) -- die\n857:   // Bildpose macht die Neigung, die Feder nur das kleine Nachschwingen.\n858:   const zielRot = Math.max(-3, Math.min(3, kopfRollSoll * 0.12));\n859:   [kDrehRot, kDrehRotV] = federSchritt(kDrehRot, kDrehRotV, zielRot, 0.020, 0.20);\n860:   [kDrehTy,  kDrehTyV ] = federSchritt(kDrehTy,  kDrehTyV,  0,      0.020, 0.20);\n861:   // 34% des AKTUELLEN (nicht Ziel-)Kopfwerts + eigene weichere Feder =\n862:   // Koerper folgt spaeter und schwaecher, ohne starren festen Versatz.\n863:   [bDrehRot, bDrehRotV] = federSchritt(bDrehRot, bDrehRotV, kDrehRot*0.34, 0.010, 0.26);\n864:   [bDrehTy,  bDrehTyV ] = federSchritt(bDrehTy,  bDrehTyV,  kDrehTy*0.34,  0.010, 0.26);\n865:   $(\"kopf-dreh\").style.transform = `rotate(${kDrehRot.toFixed(2)}deg) translateY(${kDrehTy.toFixed(1)}px)`;\n866:   $(\"koerper-dreh\").style.transform = `rotate(${bDrehRot.toFixed(2)}deg) translateY(${bDrehTy.toFixed(1)}px)`;\n867:   // Rest-Ausgleich fuer #pupillen-glow/#augen-blink -- siehe Kommentar oben\n868:   // (STIRN-LUECKE-FIX): Ziel ist jetzt kopfRollWert selbst (kDrehRot kuerzt\n869:   // sich per CSS-Vererbung von selbst weg, siehe Kommentar), UND geglaettet\n870:   // per Lerp statt hartem Sprung -- entkoppelt den Flicken vom 5\u00b0-Sprung\n871:   // des Fotowechsels, ohne ihn wahrnehmbar hinter dem echten Winkel\n872:   // zurueckfallen zu lassen (Faktor 0.4, faengt sich in 2-3 Frames).\n873:   // Geometrische Registrierung ist atomar mit dem bereits in kopfRollTick()\n874:   // sichtbaren Foto-Schritt. Nur der gemeinsame #kopf-dreh/#koerper-dreh-Wrapper\n875:   // darf federn. Eine lokale Lerp-Verzoegerung erzeugt sonst 2-3 Frames lang\n876:   // absichtliche Fehlregistrierung zwischen Foto und Augen-/Blink-Overlay.\n877:   kopfRollAusgleichDeg = kopfRollWert;\n878:   const zielOffset = KOPF_ROLL_AUGEN_OFFSET[String(kopfRollWert)] || {dx:0, dy:0};\n879:   augenOffsetDx = zielOffset.dx;\n880:   augenOffsetDy = zielOffset.dy;\n881:   const augenDxCss = augenOffsetDx * _kopfCanvasScale;\n882:   const augenDyCss = augenOffsetDy * _kopfCanvasScale;\n883:   $(\"augen-blink\").style.transform =\n884:     `translate(${augenDxCss.toFixed(2)}px, ${augenDyCss.toFixed(2)}px) rotate(${kopfRollAusgleichDeg.toFixed(2)}deg)`;\n885: }\n886: \n887: // \u2b50 2026-09-11 Crossfade statt hartem g.src=neu: ausdruckAktiv zeigt, welches\n888: // der zwei gestapelten RGBA-Bilder (#ausdruck-schicht/#ausdruck-schicht2)\n889: // gerade OBEN/sichtbar ist. Beim Wechsel wird das jeweils versteckte Element\n890: // neu befuellt und per opacity eingeblendet, das bisher sichtbare\n891: // ausgeblendet -- kein Bildsprung.\n892: // \u2b50 2026-09-11 (Bauauftrag Kopf-RGBA-Hauptebene): #gesicht/#gesicht2 haben\n893: // KEINE RGBA-Entsprechung fuer Blinzeln/Blickrichtung/Kopfneigung/6\n894: // Grundstimmungen -- diese vier Zweige (/augen/, /kopf/, /ausdruck/) sind\n895: // alte, opake, vorkomponierte Einzelbilder, die den jetzt durchscheinenden\n896: // Hintergrund wieder komplett verdecken wuerden. Deshalb tauscht diese\n897: // Funktion ab jetzt KEIN Bild mehr -- #kopf-schicht/#koerper-schicht (siehe\n898: // DOM) bleiben die sichtbare Dauerebene, das Blick-/Mundsignal kommt weiter\n899: // echt ueber die bereits-RGBA #pupillen-glow (gazeSchritt(), unveraendert)\n900: // und #mund-effekt. Was bleibt: die Funktion erkennt echte Zustandswechsel\n901: // (per Signatur-Vergleich) und loest dafuer den Kamera-Nachschwung aus --\n902: // \"passend zur Bewegung\" (Gabriel), die Kamera reagiert, wenn sich Kopf/\n903: // Blick/Ausdruck aendern, auch ohne dass ein Bild dafuer existiert. Diese\n904: // Luecke (keine 1:1-RGBA-Entsprechung fuer diese vier Basiszustaende) ist\n905: // bewusst offen, siehe Bericht an den Koordinator -- kein stilles Verstecken.\n906: let _letzteZustandsSignatur = \"\";\n907: function gesichtNeuZeichnen(mitSchwung = true){\n908:   const signatur = `${blinzelPhase}|${aktuelleBlickRichtung}|${kopfPose}|${aktuellerAusdruck}`;\n909:   if(signatur === _letzteZustandsSignatur) return; // kein echter Wechsel -- nichts zu tun\n910:   _letzteZustandsSignatur = signatur;\n911:   if(mitSchwung) kameraNachschwung();\n912: }\n913: \n914: // \u2b50 2026-09-11 Zusatz-Datensatz (FRANK_EXPRESSION_RIG_EXTRA_V1), Auftragsteil\n915: // A: weicher Wechsel in einen der 44 echt generierten Sonderausdruecke ueber\n916: // die reale stufe_00..stufe_06 Zwischensequenz -- kein Hart-Sprung auf den\n917: // Endpunkt (siehe hoch()/runter() unten, 90ms je Stufe, beide Richtungen).\n918: // Manuell ausloesbar (window.sonderausdruckZeigen in der Browser-Konsole)\n919: // UND seit Auftragsteil E automatisch fuer self_creative/-confident/\n920: // -uncertain aus sonderausdruckAusEmote() unten. Fuer self_empathetic/\n",
