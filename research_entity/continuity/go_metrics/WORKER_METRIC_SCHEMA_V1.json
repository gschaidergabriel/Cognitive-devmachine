{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CLAY_GO_WORKER_METRICS/v1",
  "title": "Clay GO Worker Metrics v1",
  "description": "Raw evidence/forecast record contributed by one Clay organ. Canonical aggregators compute derived scores; workers do not self-certify final TQE/CQS/VIS/CILR/HAAC.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "macrocycle_id",
    "worker_id",
    "source_class",
    "evidence_lineage",
    "evidence_classification"
  ],
  "properties": {
    "schema": {"const": "CLAY_GO_WORKER_METRICS/v1"},
    "macrocycle_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "organ": {"type": ["string", "null"]},
    "source_class": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "source_commit": {"type": ["string", "null"]},
    "prompt_lineage": {"type": ["string", "null"]},
    "orchestration_lineage": {"type": ["string", "null"]},
    "evidence_lineage": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      ]
    },
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_emitted_at": {"type": ["string", "null"], "format": "date-time"},
    "first_downstream_consumed_at": {"type": ["string", "null"], "format": "date-time"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "delta_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verified_delta_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "benchmark": {
      "type": ["object", "null"],
      "properties": {
        "family": {"type": "string"},
        "baseline": {"type": "number"},
        "new": {"type": "number"},
        "higher_is_better": {"type": "boolean"},
        "runs": {"type": "integer", "minimum": 1},
        "receipt": {"type": ["string", "null"]}
      }
    },
    "performance_index": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "innovation": {
      "type": ["object", "null"],
      "properties": {
        "verified": {"type": "boolean"},
        "novelty": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "measured_effect": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "transferability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "falsifiability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "prior_art_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hcu_forecast": {
      "type": ["object", "null"],
      "properties": {
        "event": {"const": "HCU_TARGET_100_GO"},
        "milestone_probabilities": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_classification": {
      "type": "object",
      "description": "Material fields must be explicitly classifiable as observed, inferred, generated or unknown.",
      "properties": {
        "observed": {"type": "array", "items": {"type": "string"}},
        "inferred": {"type": "array", "items": {"type": "string"}},
        "generated": {"type": "array", "items": {"type": "string"}},
        "unknown": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["observed", "inferred", "generated", "unknown"]
    },
    "self_reported_scores": {
      "description": "Optional diagnostic only; ignored by canonical derived-score computation.",
      "type": ["object", "null"]
    }
  }
}
