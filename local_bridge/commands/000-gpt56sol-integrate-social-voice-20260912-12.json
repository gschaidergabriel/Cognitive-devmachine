{"schema":"CLAY_LOCAL_COMMAND/v1","command_id":"000-gpt56sol-integrate-social-voice-20260912-12","op":"exec","command":"cat > /tmp/integrate_social_voice.py <<'PY'\nfrom pathlib import Path\nimport re\nS=Path('/home/ai-core-node/worktrees/presence-voice-grid-20260912/DEV_SOURCE_RESEARCH/repository/scripts')\n\ndef rw(name, fn):\n    p=S/name\n    old=p.read_text()\n    new=fn(old)\n    if new==old:\n        raise SystemExit(f'NO_CHANGE {name}')\n    p.write_text(new)\n    print('PATCHED',name,len(old),'->',len(new))\n\ndef one(s, old, new, label):\n    n=s.count(old)\n    if n!=1:\n        raise SystemExit(f'{label}: expected 1 occurrence, got {n}')\n    return s.replace(old,new,1)\n\n# 1) Stable/dynamic Rapoo camera resolution; no second camera truth.\ndef patch_capture(s):\n    s=one(s,'import dataclasses\\nimport subprocess','import dataclasses\\nimport os\\nimport subprocess\\nfrom pathlib import Path','capture imports')\n    marker='KAMERA_GERAET = "/dev/video0"'\n    if s.count(marker)!=1: raise SystemExit('capture camera marker mismatch')\n    resolver=r'''def kamera_geraet_aufloesen() -> str:\n    \"\"\"Resolve the real Rapoo webcam at process start. Device numbers are\n    not identity: on ai-core-node they have moved from /dev/video0 to\n    /dev/video1,/dev/video3. Prefer explicit env override, then the stable\n    udev by-id index0 symlink, then v4l2 label discovery. Never select the\n    unrelated Estelle v4l2loopback feed. Camera-less hosts keep the historic\n    /dev/video0 placeholder so imports remain fail-open; opening still fails\n    honestly only when a consumer actually starts capture.\"\"\"\n    override = (os.environ.get(\"FRANKENSTEIN_CAMERA_DEVICE\") or \"\").strip()\n    if override:\n        return override\n    by_id = Path(\"/dev/v4l/by-id\")\n    try:\n        hits = sorted(by_id.glob(\"*Rapoo*video-index0\"))\n        for p in hits:\n            if p.exists():\n                return str(p)\n    except OSError:\n        pass\n    try:\n        proc = subprocess.run([\"v4l2-ctl\", \"--list-devices\"], capture_output=True,\n                              text=True, timeout=5)\n        label = \"\"\n        candidates = []\n        for line in proc.stdout.splitlines():\n            if line and not line.startswith(\"\\t\"):\n                label = line.split(\"(\")[0].strip()\n            elif line.strip().startswith(\"/dev/video\") and \"Rapoo Camera\" in label:\n                candidates.append(line.strip())\n        for dev in candidates:\n            if Path(dev).exists() and \"video2\" not in dev:\n                return dev\n    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):\n        pass\n    return \"/dev/video0\"\n\n\nKAMERA_GERAET = kamera_geraet_aufloesen()'''
    s=s.replace(marker,resolver,1)\n    s=one(s,'elif zeile.strip() == geraet:','elif os.path.realpath(zeile.strip()) == os.path.realpath(geraet):','capture label realpath')\n    return s\nrw('capture_worker.py',patch_capture)\n\n# 2) Visual cortex must consume capture_worker's one camera identity.\ndef patch_vc(s):\n    if 'KAMERA_GERAET = "/dev/video0"' in s:\n        s=s.replace('KAMERA_GERAET = "/dev/video0"','KAMERA_GERAET = cwm.KAMERA_GERAET',1)\n    elif 'KAMERA_GERAET = cwm.KAMERA_GERAET' not in s:\n        raise SystemExit('visual cortex camera marker absent')\n    else:\n        raise SystemExit('visual cortex already patched unexpectedly')\n    return s\nrw('visual_cortex.py',patch_vc)\n\n# 3) Reuse the SAME persistent CaptureWorker frame for local face familiarity.\ndef patch_l0(s):\n    imp='import visual_cortex as vc  # noqa: E402\\n'\n    add=imp+'''try:\n    import person_familiarity as pfam  # local-only face familiarity, no authority\nexcept Exception as _pfam_import_error:  # camera/model-less host stays usable\n    pfam = None\nelse:\n    _pfam_import_error = None\n'''\n    s=one(s,imp,add,'l0 import')\n    marker='''                orch = L0Orchestrator(geraet=geraet, ziel_fps=max(tick_hz, 5.0)).start()\n\n            grenze = float(cfg.get("min_eskalation_sekunden", min_eskalation_sekunden))'''
    repl='''                orch = L0Orchestrator(geraet=geraet, ziel_fps=max(tick_hz, 5.0)).start()\n\n            # Social-presence head: read the latest RAM FrameRef from the SAME\n            # shared worker. No second VideoCapture, no raw-frame persistence,\n            # no cloud. person_familiarity throttles internally and only learns\n            # while its explicit opt-in is enabled.\n            if pfam is not None and pfam.opt_in_enabled() and orch.worker is not None:\n                try:\n                    _pf_ref = orch.worker.get_latest()\n                    if _pf_ref is not None:\n                        pfam.observe_frame(_pf_ref.frame, source_seq=_pf_ref.seq)\n                except Exception as _pf_e:\n                    _log(f"person_familiarity tick fehlgeschlagen (Cortex laeuft weiter): "\n                         f"{type(_pf_e).__name__}: {_pf_e}")\n\n            grenze = float(cfg.get("min_eskalation_sekunden", min_eskalation_sekunden))'''
    s=one(s,marker,repl,'l0 loop hook')\n    return s\nrw('perception_l0.py',patch_l0)\n\n# 4) Realtime: GRID directive injected per response + silence HOLD by presence.\ndef patch_rt(s):\n    imp='import speaker_handoff as sh  # owner/speaker reentry + provenance/immune guard\\n'\n    add=imp+'''try:\n    import social_presence_grid as spg\nexcept Exception as _spg_import_error:\n    spg = None\nelse:\n    _spg_import_error = None\n'''\n    s=one(s,imp,add,'rt social import')\n    # add compact directive immediately after speaker-handoff prompt context\n    marker='''        text += "\\n\\n" + sh.prompt_context(self.speaker_binding)\n        if self._gespraechs_ton_hinweis:'''\n    repl='''        text += "\\n\\n" + sh.prompt_context(self.speaker_binding)\n        if spg is not None:\n            try:\n                _social = spg.current_directive(\n                    session_active=True,\n                    scope=(self.sprecher_name or spg.primary_person()).strip().lower(),\n                )\n                text += "\\n\\n[" + _social.compact() + ";familiarity!=authority;llm=mouth]"\n            except Exception as _social_e:\n                _log(f"GRID social directive nicht verfuegbar (Voice laeuft weiter): "\n                     f"{type(_social_e).__name__}: {_social_e}")\n        if self._gespraechs_ton_hinweis:'''
    s=one(s,marker,repl,'rt directive injection')\n    marker2='''                    if still_s >= self.waechter.timeout_s:\n                        _log("5s-Beidseitig-Stille erreicht -- Session wird beendet")\n                        grund_ende = "stille_timeout"\n                        break'''
