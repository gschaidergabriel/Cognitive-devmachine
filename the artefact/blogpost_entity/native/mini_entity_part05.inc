#include <regex.h>

/* Native immutable compile/prompt/gate layer.
 *
 * This deliberately reuses the existing Mini Entity event queue as the only native
 * source authority. It does not create a second SQL/source-adapter engine. Canonical
 * probes configured by higher-level profiles are represented as unavailable here until
 * the native candidate gains an admitted probe implementation; metrics depending on
 * those probes therefore collapse to UNKNOWN rather than being fabricated.
 */
typedef struct {
    json_object *canonical;
    json_object *packet;
    json_object *metrics;
    json_object *allowed_refs;
    char canonical_hash[65];
    char packet_hash[65];
} native_compiled_t;

static int native_bool(json_object *o,const char *k,int d){json_object*v=jget(o,k);if(!v)return d;return json_object_get_boolean(v)?1:0;}
static int native_cmp_cstr(const void*a,const void*b){const char*const*aa=a;const char*const*bb=b;return strcmp(*aa,*bb);}
static void native_canon_emit(buf_t*b,json_object*v){
    if(!v){buf_add(b,"null");return;}
    enum json_type t=json_object_get_type(v);
    if(t==json_type_object){
        size_t n=(size_t)json_object_object_length(v),i=0;char**keys=xmalloc(sizeof(char*)*(n?n:1));
        json_object_object_foreach(v,k,val){(void)val;keys[i++]=xstrdup(k);}qsort(keys,n,sizeof(char*),native_cmp_cstr);
        buf_add(b,"{");for(i=0;i<n;i++){if(i)buf_add(b,",");json_object*ks=json_object_new_string(keys[i]);buf_add(b,json_object_to_json_string_ext(ks,JSON_C_TO_STRING_PLAIN));json_object_put(ks);buf_add(b,":");native_canon_emit(b,jget(v,keys[i]));free(keys[i]);}free(keys);buf_add(b,"}");return;
    }
    if(t==json_type_array){buf_add(b,"[");size_t n=(size_t)json_object_array_length(v);for(size_t i=0;i<n;i++){if(i)buf_add(b,",");native_canon_emit(b,json_object_array_get_idx(v,(int)i));}buf_add(b,"]");return;}
    buf_add(b,json_object_to_json_string_ext(v,JSON_C_TO_STRING_PLAIN));
}
static char*native_canon_text(json_object*v){buf_t b;buf_init(&b);native_canon_emit(&b,v);return buf_take(&b);}
static void native_hash_json(json_object*v,char out[65]){char*s=native_canon_text(v);sha_hex(s,strlen(s),out);free(s);}
static json_object*native_ref(json_object*root,const char*path){if(!root||!path)return NULL;char*tmp=xstrdup(path),*save=NULL,*tok=strtok_r(tmp,".",&save);json_object*cur=root;while(tok&&cur){if(json_object_get_type(cur)!=json_type_object){cur=NULL;break;}cur=jget(cur,tok);tok=strtok_r(NULL,".",&save);}free(tmp);return cur;}
static int native_truth(json_object*v){return v?json_object_get_boolean(v):0;}
static double native_num(json_object*v){if(!v)return 0.0;enum json_type t=json_object_get_type(v);if(t==json_type_double||t==json_type_int||t==json_type_boolean)return json_object_get_double(v);return 0.0;}
static int native_value_in(json_object*a,json_object*v){if(!a||json_object_get_type(a)!=json_type_array)return 0;for(size_t i=0;i<json_object_array_length(a);i++){json_object*x=json_object_array_get_idx(a,(int)i);if((!x&&!v)||(x&&v&&json_object_equal(x,v)))return 1;}return 0;}
