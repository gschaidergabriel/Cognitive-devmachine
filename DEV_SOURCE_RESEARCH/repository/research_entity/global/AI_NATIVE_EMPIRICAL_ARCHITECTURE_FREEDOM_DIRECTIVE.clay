module clay.directive.ai_native_empirical_architecture_freedom

status PROJECT_OWNER_FIXED_DIRECTIVE
effective 2026-08-10
scope all Clay research/build/test workers and all Frank v0.1 internal architecture candidates

// Owner intent:
// Internal AI architecture is not required to remain human-intuitive, biologically analogous,
// manually readable, relationally conventional, or shaped around structures humans would
// naturally design or expect. Measured behavior and empirical evidence decide promotion.

contract AINativeEmpiricalArchitectureFreedomV1 {
  invariant HUMAN_INTUITIVENESS != TRUTH
  invariant HUMAN_EXPECTATION != ARCHITECTURE_AUTHORITY
  invariant BIOLOGICAL_METAPHOR != REQUIRED_STRUCTURE
  invariant HUMAN_READABILITY != INTERNAL_REPRESENTATION_GATE
  invariant NOVELTY != EVIDENCE
  invariant OPACITY != EXEMPTION_FROM_MEASUREMENT

  rule candidate_internal_representation may be machine_native + distributed + learned + dynamic + high_dimensional + nonlinguistic + nonrelational + nonhuman_readable
  rule candidate_control_topology may depart_from familiar database|agent|module|organ|memory|graph metaphors when measurable invariants remain testable
  rule candidate may reorganize or dissolve human-named boundaries when historical causal function has been measured and successor behavior is differentially tested

  // What replaces human comprehensibility as the promotion gate.
  promotion_vector = [
    task_and_outcome_quality,
    causal_intervention_evidence,
    falsification_survival,
    heldout_and_OOD_transfer,
    replay_equivalence_where_required,
    robustness_to_perturbation,
    calibration_and_uncertainty,
    latency_distribution,
    resource_cost,
    recovery_and_rollback,
    security_and_effect_authority_integrity,
    provenance_and_identity_integrity,
    reproducibility_across_seeds_and_restarts,
    simpler_baseline_comparison
  ]

  rule promote(candidate) only_if measured_vector_is_pareto_acceptable + no_known_simpler_candidate_dominates + required_safety_authority_recovery_invariants_pass
  rule reject_or_hold(candidate) if novelty_without_benefit | hidden_unmeasured_failure | irreproducible_gain | authority_drift | unrecoverable_state | provenance_loss

  // Human auditability moves to the boundary rather than constraining the inner substrate.
  rule internal_state need_not_be_human_legible
  rule every_material_decision must_emit machine_verifiable_receipts + provenance + test_inputs + measured_outputs + uncertainty + rollback_consequence
  rule human_surface_explanation may be a derived diagnostic projection and is never canonical internal truth
  rule no hidden chain_of_thought persistence

  // AI-native search freedom.
  rule research_search_space includes learned_indexes + content_addressed_fields + differentiable_memory + associative_energy_memory + sparse_expert_memory + self_organizing_topologies + temporal_event_lattices + program_synthesized_query_plans + machine_discovered_encodings + other measurable candidates
  rule research_worker should deliberately test candidates outside conventional human database/agent metaphors when expected_information_gain_is_high
  rule physically_or_semantically_unusual design is acceptable if reversible, lesionable, benchmarked, and authority-safe

  // Evidence discipline remains absolute.
  rule synthetic_result != target_live_result
  rule repeated_same_ancestry != independent_replication
  rule activation_similarity_rank != truth
  rule model_output != effect_authority
  rule human_discomfort_or_unfamiliarity alone cannot reject a candidate
  rule human_appeal_or_elegance alone cannot promote a candidate

  target = "Frank v0.1 measurable machine-native cognition on accepted target VPS"
}
