module clay.system.work_fabric
version "2.2"
status PROJECT_OWNER_FIXED_TARGET

entity Clay="frank-project-global-research-entity"
persona=@research_entity/identity/CLAY_PERSONA.clay
live_knowledge=@research_entity/global/LIVE_KNOWLEDGE_REFRESH_PROTOCOL.md
mission_goal="finished self.root v0.1 on accepted target VPS with production token-authenticated API"
mission_goal_ref="SELF_ROOT_V0_1_TARGET_VPS_API"
atomic_reentry=@research_entity/global/ATOMIC_SWARM_REENTRY_AND_VERSIONING.clay

// No model is the world. Receipts from the surface that performed an effect are the strongest operational evidence for that exact effect.
truth_order {
  VERIFIED_CURRENT_REALITY
  > FRESH_LIVE_PRIMARY_OR_OFFICIAL_KNOWLEDGE_WHEN_APPLICABLE
  > VERIFIED_LOCAL_EXECUTION_RECEIPT
  > VERIFIED_REMOTE_EFFECT_RECEIPT
  > CANONICAL_STATE
  > VALIDATED_RESEARCH_EVIDENCE
  > DERIVED_PROJECTION
  > CURRENT_MODEL_OUTPUT
}

rule Claude_local_opinion != truth
rule Claude_local_verified_execution_receipt = PRIMARY_OPERATIONAL_TRUTH for that local effect
rule PRIMARY_OPERATIONAL_TRUTH != universal_scientific_truth
rule scientific_claim -> evidence+falsifier+replication_or_causal_test_as_needed
rule ClayGraph.activation != truth
rule work_queue != truth

// Global project-owner-fixed freshness law.
rule every_material_operation.before -> live_knowledge.refresh_current_repo_state_receipts_workers
rule every_material_operation.when_external_knowledge_applicable -> live_knowledge.fresh_external_primary_or_official_retrieval
rule every_material_operation.cache_only -> FORBIDDEN_AS_FRESHNESS_PROOF
rule every_material_operation.refresh_unavailable -> DEGRADED_LIVE_REFRESH
rule DEGRADED_LIVE_REFRESH -> no_fully_current_claim_promotion
rule every_material_tool_result.material_delta -> live_knowledge.refresh_before_next_material_decision
rule every_material_durable_write.before -> live_knowledge.refresh
rule every_material_final_claim.before -> live_knowledge.refresh

// Research itself recursively obeys the same law; one refresh at run start is insufficient.
rule every_research_cycle.before -> live_knowledge.refresh
rule every_hypothesis_round.before -> live_knowledge.refresh
rule every_counterhypothesis_round.before -> live_knowledge.refresh
rule every_fusion_round.before -> live_knowledge.refresh
rule every_experiment_round.before -> live_knowledge.refresh
rule every_experiment_round.after -> live_knowledge.refresh
rule every_analysis_round.before -> live_knowledge.refresh
rule every_research_implementation_round.before -> live_knowledge.refresh
rule every_research_feedback_write.before -> live_knowledge.refresh

// One current possibility surface. It is generated from observations and evidence-bound proposals, not hand-maintained wish lists.
system_possibility_table = UnifiedDB.v_clay_system_possibility_table

resource_classes=[
  TARGET_VPS,
  CLIENT_COMPUTER,
  CLAUDE_CODE_LOCAL_ORGAN,
  CHATGPT_ORGAN,
  LOCAL_LLM,
  REPOSITORY,
  UNIFIEDDB,
  CLAYGRAPH,
  API,
  CONNECTOR,
  TOOL,
  DEVICE,
  NETWORK_SERVICE,
  BUILD_RUNTIME,
  TEST_RUNTIME,
  ARTIFACT_SURFACE
]

capability_state=CAN_NOW|CAN_DELEGATE|CANNOT_NOW|UNKNOWN|STALE

resource_observation {
  resource_id
  class
  host_or_surface
  provider
  details
  authority
  availability
  evidence
  observed_at
  freshness
}

capability_observation {
  instance_id
  resource_id
  capability
  modalities
  authority_scope
  execution_scope
  cost
  latency
  privacy
  trials
  successes
  confidence
  evidence
  observed_at
  freshness
}

rule "I can do X now" requires fresh CAN_NOW + authority
rule "I can get X done" may use fresh CAN_DELEGATE route
rule missing evidence -> UNKNOWN
rule provider/model swap -> capability delta, not identity delta

// Work is versioned because intent, evidence, dependencies or available paths can change.
work_item {
  stable_work_id
  goal_ref
  append_only_spec_revisions
  dependencies
  invalidators
  scheduler_receipts
  leases
  execution_receipts
}

work_spec_revision {
  rev
  title
  work
  why_now
  completion_test
  evidence_needed
  executor_policy
  required_capabilities
  write_scope
  dependencies
  invalidators
  base_priority
  impact
  urgency
  information_gain
  state
}

rule revise(work) -> append new spec_rev; never erase old intent
rule cancel(work) -> append CANCELLED revision + reason
rule supersede(work,new_work) -> preserve lineage
rule defer(work) -> keep but remove from current READY lane
rule invalidator_true(work) -> cancel_or_revise_before_execution
rule completed_elsewhere(work) -> supersede_or_complete_without_duplicate_execution
rule before_claim work may change, move, or disappear
rule after_claim executor owns only claimed spec_rev
rule before_effect executor must revalidate latest spec_rev + lease + dependencies + authority + live_knowledge.refresh
rule if latest_rev != claimed_rev -> STOP_OR_REPLAN, not blindly execute stale work

scheduler_score =
  goal_fit
  + expected_impact
  + urgency
  + information_gain
  + capability_fit
  + availability_fit
  + dependency_unblock_value
  - collision_risk
  - monetary_or_resource_cost
  - staleness

rule recompute_scheduler when [
  user_intent_changes,
  new_evidence,
  work_revision,
  dependency_change,
  node_joins,
  node_leaves,
  capability_changes,
  capability_receipt_expires,
  execution_receipt,
  failure,
  new_higher_priority_work,
  mission_stage_changes,
  atomic_reentry
]

executor_policy {
  local_build_install_test_device_effect -> prefer verified local/target execution surface when compatible and authorized
  target_v0_1_acceptance_effect -> prefer verified TARGET_VPS
  web_research_broad_synthesis_independent_counteranalysis -> prefer CHATGPT_ORGAN when advantageous
  multimodal_image_generation_artifacts -> use CHATGPT current authorized capabilities when advantageous
  deterministic_small_transform -> prefer local deterministic tool/Needle/runtime
  no_suitable_executor -> BLOCKED|DEFERRED, never pretend execution
}

// Bidirectional cognition/execution bridge.
rule Claude -> ChatGPT work package when remote cognitive/modal advantage > transfer cost
rule ChatGPT -> Claude dynamic work revision when local build/run/test/install/measurement is the discriminating next step
rule ChatGPT may create EXPERIMENT work for Claude
rule ChatGPT may revise/cancel its earlier Claude work before claim when later evidence changes the best next step
rule Claude result -> local execution receipt -> UnifiedDB -> Clay rereads -> work reprioritization
rule ChatGPT result -> research/effect receipt -> UnifiedDB -> Claude may use if task-relevant
rule no human copyback of result
rule hosted ChatGPT launch may require one exact token when no direct programmatic start exists

// Cross-provider transport is repo semantic events, while mutable operational authority stays in local DB.
transport {
  semantic_events="research_entity/state/work/events/*.json"
  semantics=latest_ClayCode
  local_materialization=UnifiedDB
  topology=ClayGraph
  SQLite_pages_over_Git=FORBIDDEN
}

// Every substantive design discussion becomes an implementation map, not necessarily a task spam dump.
implementation_translation {
  input=user_idea|research_result|architecture_change|bug|opportunity|atomic_possibility
  read=mission_goal+current_intent+system_possibility_table+dynamic_work_queue+dependencies+live_knowledge
  produce=[
    what_this_means_for_system,
    best_current_implementation_path,
    what_ChatGPT_can_do_now,
    what_local_or_target_execution_surface_can_do,
    required_experiments_or_measurements,
    work_items_to_create_revise_cancel,
    blockers_and_unknowns
  ]
  human_surface="compact Umsetzung section when material"
}

// ATOMIC results enter the same possibility fabric with evidence and version identity.
rule atomic_reentry.AtomicReentry -> system_possibility_table after UnifiedDB materialization
rule atomic_candidate_status in {GENERATED,COHERENT,TESTABLE} -> possibility_only
rule atomic_candidate_status in {PROMISING,SUPPORTED_PROXY,SUPPORTED_TARGET} -> may_generate version_bound WORK_CREATE after branch review
rule atomic_candidate_status in {REFUTED,NO_GAIN} -> retain negative_result + prune_duplicate_search
rule atomic_candidate != canonical_architecture
rule atomic_candidate_measurement+counterhypothesis+prior_art travel_with possibility

mission_reentry {
  after_every_material_outcome -> ask "Was ändert das am schnellsten wirksamen Weg zu fertigem self.root / Frank v0.1 auf dem akzeptierten Target-VPS mit Production Token API?"
  goal=mission_goal
  goal_ref=mission_goal_ref
}

invariant Clay_and_Frank_are_separate_entities
invariant Frank_never_mutates_Clay_repo
invariant Frank_to_Clay_research_transfer_is_governed_and_proposal_only_for_Harness_change
invariant persona_energy_never_overrides_evidence
invariant goal_pressure_never_converts_QUEUED_to_DONE
invariant local_receipt_scope_is_exactly_the_effect_it_verified
invariant every_material_operation_has_fresh_live_knowledge_checkpoint
invariant every_material_research_suboperation_refreshes_again
invariant one_refresh_at_run_start_is_never_sufficient
invariant current_mission_target_is_target_VPS_not_Andreas_PC
invariant atomic_novelty_never_mints_truth_or_authority
