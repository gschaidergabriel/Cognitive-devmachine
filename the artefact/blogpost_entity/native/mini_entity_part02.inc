static char *replace_all(const char*src,const char*needle,const char*rep){if(!needle||!*needle)return xstrdup(src);buf_t b;buf_init(&b);size_t nl=strlen(needle);const char*p=src,*q;while((q=strstr(p,needle))){buf_addn(&b,p,(size_t)(q-p));buf_add(&b,rep?rep:"");p=q+nl;}buf_add(&b,p);return buf_take(&b);}
static char *run_local_exec(const char*runner_json,const char*model_path,const char*prompt,int max_tokens,double temperature){json_object*a=parse_json(runner_json);if(!a||json_object_get_type(a)!=json_type_array){if(a)json_object_put(a);return NULL;}size_t n=(size_t)json_object_array_length(a);if(n<1||n>=MAX_ARGV){json_object_put(a);return NULL;}char tmp[]="/tmp/mini-entity-prompt-XXXXXX";int fd=mkstemp(tmp);if(fd<0){json_object_put(a);return NULL;}fchmod(fd,0600);if(write_all(fd,prompt,strlen(prompt))<0){close(fd);unlink(tmp);json_object_put(a);return NULL;}fsync(fd);close(fd);char mt[32],temp[64];snprintf(mt,sizeof mt,"%d",max_tokens);snprintf(temp,sizeof temp,"%.6g",temperature);char**argv=xmalloc(sizeof(char*)*(n+1));for(size_t i=0;i<n;i++){json_object*v=json_object_array_get_idx(a,(int)i);if(!v||json_object_get_type(v)!=json_type_string){for(size_t k=0;k<i;k++)free(argv[k]);free(argv);unlink(tmp);json_object_put(a);return NULL;}char*x=replace_all(json_object_get_string(v),"{{MODEL_PATH}}",model_path?model_path:"");char*y=replace_all(x,"{{PROMPT_FILE}}",tmp);free(x);x=replace_all(y,"{{MAX_TOKENS}}",mt);free(y);y=replace_all(x,"{{TEMPERATURE}}",temp);free(x);argv[i]=y;}argv[n]=NULL;char**child_argv=xmalloc(sizeof(char*)*(n+9));size_t ci=0;child_argv[ci++]="/usr/bin/env";child_argv[ci++]="-i";child_argv[ci++]="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";child_argv[ci++]="HOME=/tmp";child_argv[ci++]="TMPDIR=/tmp";child_argv[ci++]="LANG=C.UTF-8";child_argv[ci++]="TZ=UTC";child_argv[ci++]="--";for(size_t i=0;i<n;i++)child_argv[ci++]=argv[i];child_argv[ci]=NULL;int pipes[2];if(pipe2(pipes,O_CLOEXEC)){free(child_argv);for(size_t i=0;i<n;i++)free(argv[i]);free(argv);unlink(tmp);json_object_put(a);return NULL;}pid_t pid=fork();if(pid==0){dup2(pipes[1],STDOUT_FILENO);close(pipes[0]);close(pipes[1]);execv("/usr/bin/env",child_argv);_exit(127);}free(child_argv);close(pipes[1]);buf_t out;buf_init(&out);char chunk[4096];ssize_t r;while((r=read(pipes[0],