  "nonduplicate_gap": {
    "name": "DECLARED_SNAPSHOT_IDENTITY_IS_NOT_CONSUMED_SNAPSHOT_IDENTITY",
    "classification": "R1_INFERENCE_FROM_CURRENT_PROOF_LAW",
    "finding": "The current stale-evidence repairs correctly require epoch/digest/generation freshness, but packet fields can still only prove declared metadata unless the runtime binds them to the exact S1 snapshot actually consumed by the node. A caller can copy current epoch/digest fields onto a payload computed from older S1 bytes. Field equality therefore cannot by itself mint observation-currentness credit.",
    "analogy": "PRE_LOAD_HASH_IS_NOT_LOADER_ATTESTATION; similarly DECLARED_SNAPSHOT_HASH_IS_NOT_NODE_READ_ATTESTATION.",
    "required_boundary": "Positive physical-GRID10 observation evidence should bind node process identity, read event/transaction identity, exact S1 snapshot identity, result packet digest, executable source identity and timing/liveness receipt. Model- or caller-supplied booleans must not substitute for the binding."
  },
  "hypothesis": {
    "claim": "A consumed-snapshot attestation boundary closes a stale-evidence relabeling class that survives simple packet epoch/digest equality checks.",
    "counterhypothesis": "Exact packet epoch+digest+generation equality is sufficient because only trusted deterministic code can construct NODE_RESULT packets.",
    "falsifier": "If the exact current producer path is proven to derive packet snapshot fields directly from an immutable S1 read transaction and cryptographically binds that transaction to the packet payload/result digest with no mutable caller override, this extra attestation layer becomes redundant at that boundary. Until that source/runtime proof exists, fail closed."
  },
  "minimum_attestation_contract": {
    "required_fields_or_equivalent": [
      "node_process_id",
      "node_process_start_identity",
      "producer_source_hash",
      "s1_read_transaction_or_snapshot_id",
      "s1_state_epoch_observed",
      "s1_state_digest_observed",
      "generation_observed",
      "result_packet_digest",
      "read_to_result_binding_digest_or_receipt",
      "barrier_or_liveness_receipt_ref"
    ],
    "runtime_law": [
      "The attested observed epoch/digest/generation must be derived from the actual read boundary, not copied from packet metadata supplied later.",
      "The result packet digest must be bound to that consumed snapshot receipt.",
      "A coordinator may reject, reread/recompute, or invoke a separately admitted rebase protocol; it may not silently rewrite observation identity.",
      "Ordinary Xeno nodes remain S1 read-only; consumed-snapshot attestation never grants S1, S0 or effect authority.",
      "A model may learn to recognize the evidence classes later, but deterministic runtime gates remain authoritative."
    ]
  },
