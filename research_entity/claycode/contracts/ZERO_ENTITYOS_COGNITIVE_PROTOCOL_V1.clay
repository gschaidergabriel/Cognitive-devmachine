module entityos.cognition.protocol
version "1.0"
status CURRENT_OWNER_ALIGNED_SOURCE_CONTRACT

record EpistemicItem {
  epistemic_class:String
  claim_ref:String
  evidence_refs:List<String>
}

record DBStateRef {
  ref_id:String
  store:String
  snapshot_or_epoch:Int
  object_key:String
  digest:String
  provenance:String
  mutability:String
}

record GridRuntime {
  requested_N:Int
  available_N:Int
}

record ResourceBudget {
  budget_ref:String
}

record CompletionContract {
  contract_ref:String
}

record GridExecutorBinding {
  grid_instance_id:String
  requested_N:Int
  available_N:Int
  executor_id:String
  lease_id:String
  process_id:String
  runtime_identity:String
  started_at:String
  ended_at:String
}

record DBWriteProposal {
  proposal_id:String
  source_result_id:String
  generation:Int
  state_snapshot_ref:DBStateRef
  object_key:String
  value_ref:String
  value_digest:String
  canonical_commit:Bool
}

record EffectProposal {
  proposal_id:String
  source_result_id:String
  generation:Int
  capability_scope_ref:String
  request_ref:String
  request_digest:String
  executed:Bool
}

record WorkspaceReentry {
  source_result_id:String
  source_process_id:String
  causal_event_id:String
  from_workspace_epoch:Int
  to_workspace_epoch:Int
  reentry_payload_ref:String
  reentry_digest:String
  observed_downstream_change:String
  causal_credit:Bool
}

record ClaudeCodeBridgePacket {
  bridge_id:String
  direction:String
  causal_event_id:String
  work_id:String
  workspace_epoch:Int
  interface_class:String
  payload_ref:String
  payload_digest:String
  state_refs:List<DBStateRef>
  tool_scope_ref:String
  request_or_result_identity:String
  activation_access_observed:Bool
}

record JSpaceMeasurement {
  measurement_id:String
  causal_event_id:String
  exact_model_runtime_identity:String
  exposed_interface_class:String
  observed:Bool
  intervened:Bool
  measurement_ref:String
  causal_credit:Bool
}

record CognitiveWorkPacket {
  schema:String
  causal_event_id:String
  admission_id:String
  generation:Int
  work_id:String
  process_id:String
  parent_work_ids:List<String>
  workspace_epoch:Int
  state_snapshot_ref:DBStateRef?
  input_refs:List<String>
  epistemic_inputs:List<EpistemicItem>
  capability_scope_ref:String
  resource_budget:ResourceBudget
  grid_runtime:GridRuntime
  route_policy_ref:String
  completion_contract:CompletionContract
}

record CognitiveResultPacket {
  schema:String
  causal_event_id:String
  admission_id:String
  generation:Int
  work_id:String
  process_id:String
  executor_binding:GridExecutorBinding
  result_id:String
  result_class:String
  result_payload_ref:String
  result_digest:String
  evidence_refs:List<String>
  unknowns:List<String>
  db_write_proposals:List<DBWriteProposal>
  effect_request_candidates:List<EffectProposal>
  workspace_reentry:WorkspaceReentry?
  runtime_receipt:String?
}

type CognitivePacket = CognitiveWorkPacket | CognitiveResultPacket | ClaudeCodeBridgePacket | WorkspaceReentry | JSpaceMeasurement

interface CognitiveProcess {
  execute(work:CognitiveWorkPacket) -> CognitiveResultPacket
}

law runtime_N distinct_from process_identity
law physical_executor_identity distinct_from process_identity
law GRID10 distinct_from architecture_identity
law model_output never_confers canonical_truth
law workspace_winner never_confers canonical_truth
law ClaudeCodeBridgePacket never_confers canonical_truth
law JSpaceMeasurement never_confers canonical_truth
law DBWriteProposal required_before DeterministicStateAdmission
law EffectProposal required_before EffectGate
law workspace_reentry_presence never_implies causal_use
law generated_candidate cannot_authorize real_effect
law capability_claim never_confers capability_authority
law missing_fact distinct_from false_fact
law ClaudeCodeBridgePacket never_implies hidden_activation_access
law GlobalJSpaceClaim requires exposed_causal_interface
