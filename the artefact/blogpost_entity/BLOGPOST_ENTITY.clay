// Generic persistent text-entity processing pipeline.
// Application identity, sources, prompts, metrics, inference backend and output schema are DB/profile data.
// The compiled binary owns only orchestration and invariant enforcement.
module clay.entity_pipeline

fn payload(key:String, value:String)->Map {
  let m = map_new()
  map_set(m,key,value)
  return m
}

fn phase(kind:String, entity_db:String, source_db:String, profile:Map, previous:Map, data:Map)->Map {
  let p = map_new()
  map_set(p,"entity_db",entity_db)
  map_set(p,"source_db",source_db)
  map_set(p,"profile",profile)
  map_set(p,"previous",previous)
  map_set(p,"data",data)
  return effect(kind,p)
}

fn run(entity_db:String, source_db:String, secret_file:String)->Map {
  // Boot the neutral MiniUnifiedDB before asking it for application/personality state.
  // A fresh database is therefore initialized by the executable itself and then fails
  // closed at profile read until an explicit profile has been imported/configured.
  let initialized = phase("pipeline_init",entity_db,source_db,map_new(),map_new(),map_new())
  require initialized.ok

  // Active application/personality/inference profile is persistent DB state.
  // External preset JSON is only an import/configuration surface, never a mandatory runtime file.
  let profile_req = payload("entity_db",entity_db)
  let loaded = effect("pipeline_profile_read",profile_req)
  require loaded.ok
  let profile = loaded.profile

  let previous = phase("pipeline_state_read",entity_db,source_db,profile,map_new(),map_new())
  require previous.ok

  let collected = phase("pipeline_collect",entity_db,source_db,profile,previous,map_new())
  require collected.ok

  let compiled = phase("pipeline_compile",entity_db,source_db,profile,previous,collected)
  require compiled.ok

  let prompt = phase("pipeline_build_prompt",entity_db,source_db,profile,previous,compiled)
  require prompt.ok

  // Canonical cognition admission is on the causal path, not a sidecar receipt.
  // The runtime effect must bind this exact generation/state/prompt into the single
  // Unified J-Space/GWT Cognitive Fabric and return only a candidate-inference envelope.
  // It must not mint MiniUnifiedDB truth/state, identity or direct effect authority.
  let cognition_data = map_new()
  map_set(cognition_data,"compiled",compiled)
  map_set(cognition_data,"prompt",prompt)
  let admitted = phase("pipeline_cognitive_fabric_admit",entity_db,source_db,profile,previous,cognition_data)
  require admitted.ok

  // One inference contract for Claude Code, bundled local cognition, adaptive APIs,
  // loopback local servers or local model runners. Raw profile/prompt data may not
  // bypass Cognitive Fabric admission; only the admitted candidate envelope is used.
  let infer = map_new()
  map_set(infer,"inference",admitted.inference)
  map_set(infer,"system",admitted.system)
  map_set(infer,"user",admitted.user)
  map_set(infer,"inference_packet_digest",admitted.inference_packet_digest)
  map_set(infer,"cognitive_fabric_receipt_digest",admitted.cognitive_fabric_receipt_digest)
  map_set(infer,"secret_file",secret_file)
  let generated = effect("inference_generate",infer)
  require generated.ok

  let gate_data = map_new()
  map_set(gate_data,"generated",generated)
  map_set(gate_data,"compiled",compiled)
  map_set(gate_data,"prompt",prompt)
  map_set(gate_data,"cognitive_fabric",admitted)
  let gated = phase("pipeline_gate",entity_db,source_db,profile,previous,gate_data)
  require gated.ok

  let commit_data = map_new()
  map_set(commit_data,"gated",gated)
  map_set(commit_data,"compiled",compiled)
  map_set(commit_data,"collected",collected)
  map_set(commit_data,"generated",generated)
  map_set(commit_data,"cognitive_fabric",admitted)
  let committed = phase("pipeline_commit",entity_db,source_db,profile,previous,commit_data)
  require committed.ok

  let result = map_new()
  map_set(result,"ok",true)
  map_set(result,"output_id",committed.output_id)
  map_set(result,"generation",committed.generation)
  map_set(result,"source_count",compiled.source_count)
  map_set(result,"profile_id",profile.profile_id)
  map_set(result,"inference_kind",admitted.inference.kind)
  map_set(result,"canonical_state_hash",compiled.canonical_state_hash)
  map_set(result,"packet_hash",compiled.packet_hash)
  map_set(result,"inference_packet_digest",admitted.inference_packet_digest)
  map_set(result,"cognitive_fabric_receipt_digest",admitted.cognitive_fabric_receipt_digest)
  return result
}
