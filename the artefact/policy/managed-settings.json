{
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedChannelPlugins": [],
  "allowedMcpServers": [
    {
      "serverCommand": [
        "/usr/local/bin/python",
        "-m",
        "clayverse.mcp_server"
      ]
    }
  ],
  "autoMemoryEnabled": false,
  "channelsEnabled": false,
  "crossSessionInbound": "refuse",
  "disableAgentView": true,
  "disableArtifact": true,
  "disableAutoMode": "disable",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableDeepLinkRegistration": "disable",
  "disableRemoteControl": true,
  "disableSideloadFlags": true,
  "disableSkillShellExecution": true,
  "disableWorkflows": true,
  "isolatePeerMachines": true,
  "strictKnownMarketplaces": [],
  "env": {
    "DISABLE_UPDATES": "1",
    "CLAUDE_CODE_DISABLE_ATTACHMENTS": "1",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_SHELL_PREFIX": "/opt/clayverse/runtime/deny-shell"
  },
  "permissions": {
    "allow": [
      "mcp__clayverse__session_state",
      "mcp__clayverse__request_effect",
      "mcp__clayverse__request_autonomy_effect",
      "mcp__clayverse__udb_embedding_search",
      "mcp__clayverse__udb_embedding_store",
      "mcp__clayverse__udb_neuropedia_activation",
      "mcp__clayverse__udb_memory_add",
      "mcp__clayverse__udb_memory_search"
    ],
    "deny": [
      "Bash",
      "Artifact"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/python -m clayverse.terminal_hooks user_prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/python -m clayverse.terminal_hooks stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/python -m clayverse.terminal_hooks stop_failure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
