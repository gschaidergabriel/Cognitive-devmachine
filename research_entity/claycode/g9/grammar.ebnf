(* ClayCode G9 candidate surface grammar. Canonical semantics live in typed IR, not text. *)
program      = { statement } ;
statement    = module_decl | version_decl | law_decl | rule_decl | invariant_decl | type_decl | record_decl | relation_decl | hyper_decl | hp_decl | tensor_decl | query_decl | view_decl | entity_decl | capability_decl | affordance_decl | intent_decl | effect_decl | prospect_decl | coalition_decl | credit_decl | reader_decl | projection_decl | adapt_decl | codec_decl | surface_decl | cycle_decl ;
module_decl  = "module", qid ;
version_decl = "version", string ;
law_decl     = "law", expr, "=", expr ;
rule_decl    = "rule", expr ;
invariant_decl = "invariant", expr ;
type_decl    = ("class"|"type"), ident, [type_params], "=", expr ;
record_decl  = "record", ident, [type_params], block ;
relation_decl= "relation", ident, block ;
hyper_decl   = "hyper", ident, block ;
hp_decl      = "hp", ident, [type_params], block ;
tensor_decl  = "tensor", ident, "=", list ;
query_decl   = "query", ident, [type_params], block ;
view_decl    = "view", ident, [type_params], "=", expr ;
entity_decl  = "entity", ident, block ;
capability_decl = "capability", ident, block ;
affordance_decl = "affordance", ident, block ;
intent_decl  = "intent", ident, block ;
effect_decl  = "effect", ident, block ;
prospect_decl= "prospect", ident, block ;
coalition_decl = "coalition", ident, block ;
credit_decl  = "credit", ident, block ;
reader_decl  = "reader", ident, block ;
projection_decl = "projection", ident, block ;
adapt_decl   = "adapt", ident, block ;
codec_decl   = "codec", ident, "=", ident, [ident] ;
surface_decl = "surface", ident ;
cycle_decl   = "cycle", "(", [params], ")", block ;
block        = "{", { field | statement | action_stmt }, "}" ;
field        = ident, ":", type_expr, ["=", expr] ;
action_stmt  = ["let", ident, "="], expr ;
params       = param, {",", param} ;
param        = ident, [":", type_expr] ;
type_params  = "<", ident, {",", ident}, ">" ;
type_expr    = qid, [type_params], ["?"] | "Set", "<", type_expr, ">" | "Map", "<", type_expr, ",", type_expr, ">" | "Ordered", "<", type_expr, ">" ;
expr         = primary, { operator, primary } ;
primary      = qid | number | string | boolean | list | set | call | "(" , expr , ")" ;
call         = qid, "(", [expr, {",", expr}], ")" ;
list         = "[", [expr, {",", expr}], "]" ;
set          = "{", [expr, {",", expr}], "}" ;
operator     = "="|"!="|"=="|"->"|"|"|"+"|"-"|"*"|"/"|"&&"|"||"|"iff"|"requires"|"in"|"subset_of" ;
qid          = ident, {".", ident} ;
ident        = letter, {letter|digit|"_"|"-"} ;
string       = '"', { ? escaped UTF-8 char ? }, '"' ;
number       = ["-"], digit, {digit}, [".", digit, {digit}] ;
boolean      = "true" | "false" ;
letter       = "A".."Z" | "a".."z" | "_" ;
digit        = "0".."9" ;
