{
  "schema_version": "HCU_FREE_LLM_FEED/v2",
  "status": "OWNER_DIRECTED_SOURCE_CONTRACT",
  "purpose": "Optional FREE_ONLY external worker/candidate feed for unresolved questions; external providers are never required internal HCU cognition.",
  "cognitive_independence": {
    "required_for_hcu_boot": false,
    "required_for_world_model_continuity": false,
    "required_for_semantic_retrieval": false,
    "required_for_zero_projection": false,
    "provider_embedding_dependency": false,
    "provider_role": "WORKER_OR_TARGETED_FALLBACK_CANDIDATE_ONLY"
  },
  "provider_examples": {
    "nvidia": "WORKER_OR_OPTIONAL_CANDIDATE_ONLY",
    "mistral": "WORKER_OR_OPTIONAL_CANDIDATE_ONLY",
    "groq": "WORKER_OR_OPTIONAL_CANDIDATE_ONLY",
    "claude_code": "PREFERRED_TARGETED_HIGH_CAPABILITY_CANDIDATE_INFERENCE"
  },
  "input_packet": {
    "required": [
      "feed_request_id",
      "provider_profile_id",
      "model_id",
      "requested_at",
      "query_class",
      "causal_anchor",
      "response_text_or_structured_payload",
      "usage_receipt",
      "provenance"
    ],
    "forbidden": [
      "plaintext_api_token",
      "secret_value",
      "unbounded_host_command",
      "direct_effect_capability",
      "canonical_truth_claim"
    ]
  },
  "admission_pipeline": [
    "secret_scan_and_redaction_fail_closed",
    "request_identity_dedupe",
    "provider_and_model_provenance_binding",
    "schema_validation",
    "candidate_classification",
    "correlated_source_warning",
    "conflict_and_counterevidence_linking",
    "MiniUnifiedDB_candidate_write",
    "reactive_HCU_scheduler_notification"
  ],
  "truth_law": {
    "provider_output_is_truth": false,
    "provider_consensus_is_truth": false,
    "repetition_is_independent_evidence": false,
    "canonical_promotion_requires": "normal Mini Entity evidence/falsification/admission rules"
  },
  "budget_policy": {
    "mode": "FREE_ONLY",
    "paid_fallback": false,
    "together_execution": "FORBIDDEN_CURRENT_OWNER_CONTROL",
    "http_402": "HARD_STOP",
    "http_429": "PROVIDER_WIDE_BACKOFF",
    "quota_evasion_key_rotation": false
  },
  "scheduling": {
    "prefer": [
      "unresolved_high_value_questions",
      "source_diversity",
      "counterhypotheses",
      "falsifiers",
      "causal_gap_filling"
    ],
    "deprioritize": [
      "duplicate_consensus",
      "low_provenance_repetition",
      "already_resolved_questions"
    ]
  },
  "authority": {
    "canonical_state": "MiniUnifiedDB",
    "real_effects": "EffectGate",
    "external_model_role": "CANDIDATE_INFERENCE_ONLY"
  }
}
